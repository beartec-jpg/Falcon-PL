# Default lab stack — freeze this for boring ops (2 shards).
# Source: set -a; source deploy/gmp/stack.env.default; set +a

export SSH_F2="${SSH_F2:-100.64.0.3}"
export F1_IP="${F1_IP:-}"          # auto-detect if empty
export F2_IP="${F2_IP:-192.0.2.2}"
export MESH_ROOT="${MESH_ROOT:-$HOME/falcon-dag-mesh}"
export FALCON_RS="${FALCON_RS:-$HOME/falcon-dag/falcon-dag-rs}"
export STACK_SHARDS="${STACK_SHARDS:-2}"
# Lab digs default 9930; public testnet uses 9003 (s0) / 9004 (s1)
export NETWORK_ID_BASE="${NETWORK_ID_BASE:-9930}"
export FACADE_URL="${FACADE_URL:-http://127.0.0.1:18499}"
export FACADE_LISTEN="${FACADE_LISTEN:-0.0.0.0:18499}"
export XSHARD_TIMEOUT_S="${XSHARD_TIMEOUT_S:-45}"

# Bridge min balance alert (native units). Lab faucet starts ~1e9.
export BRIDGE_MIN_BALANCE="${BRIDGE_MIN_BALANCE:-1000000}"
# Validator GMP advert older than this → degraded
export ADVERT_STALE_S="${ADVERT_STALE_S:-30}"

# Watchdog
export WATCHDOG_INTERVAL_S="${WATCHDOG_INTERVAL_S:-60}"
export SMOKE_EVERY_N="${SMOKE_EVERY_N:-5}"   # run smoke every N health loops
export LOG_MAX_MB="${LOG_MAX_MB:-50}"
export RESTART_COOLDOWN_S="${RESTART_COOLDOWN_S:-120}"
export RESTART_MAX_PER_HOUR="${RESTART_MAX_PER_HOUR:-3}"
