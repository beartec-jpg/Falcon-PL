# Falcon PL public testnet 2300: network profile for install-falcon-node.sh.
# KEY=VALUE only (parsed, never sourced). Published with every release and checksummed in SHA256SUMS.
NETWORK_ID=2300
NETWORK_NAME=falcon-pl-public-testnet-2300
SCHEME=falcon-512
# Public door: Helsinki 8 GB relay (5.78.142.246). One TCP port per live seat.
# v12 listens locally on that host; the other six are forwarded over Tailscale.
# The office and home routers are not in this path.
SEEDS=5.78.142.246:19301,5.78.142.246:19303,5.78.142.246:19306,5.78.142.246:19307,5.78.142.246:19311,5.78.142.246:19312,5.78.142.246:19313
HUBS=5.78.142.246:19301,5.78.142.246:19303
STATUS_RPC=5.78.142.246:19301
# Genesis validator set (consensus: must match the seats exactly).
GENESIS_VALIDATORS=v1,v2,v3,v4,v5
GENESIS_BOND=1000
EPOCH_MS=604800000
FIRST_CLAIM_EPOCH=1
UNBOND_COOLDOWN_MS=1209600000
ONLINE_EPOCH_HEIGHTS=10
SEAL_INTERVAL_MS=200
PACK_BUDGET_MS=1000
PROGRESS_TIMEOUT_MS=3000
MAX_TXS=0
MAX_MEMPOOL_TXS=50000
SNAPSHOT_INTERVAL_MS=60000
MAX_CHAIN_LEDGERS=128
# Validator admission (2.9.62+): new ids need Scott's ApproveValidator and a bond >= MIN_BOND_NEW.
MIN_BOND_NEW=50000
TX_FEE=2
FIRST_VALIDATOR_VERSION=2.9.63
# Helsinki seeds answer, and every live seat is on 2.9.66 (profile for release v2.9.66).
VALIDATOR_ONBOARDING=open
SITE=https://falcon-fpl.com
APPLY_URL=https://falcon-fpl.com/validator/apply
APPLICATIONS_REPO=beartec-jpg/falcon-pl-validators
