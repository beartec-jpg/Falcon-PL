[Unit]
Description=Falcon PL Bitcoin header submitter (BTC rail SPV)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=falcon
WorkingDirectory=/home/falcon/falcon-pl-public-testnet-2300
Environment=PL_ROOT=/home/falcon/falcon-pl-public-testnet-2300
Environment=FPL_CTL=/home/falcon/falcon-pl-public-testnet-2300/bin/falcon-pl-ctl
Environment=FPL_RPC=127.0.0.1:19301,100.64.0.2:19302,100.64.0.3:19303
Environment=FPL_KEYS=/home/falcon/falcon-pl-public-testnet-2300/keys
Environment=FPL_WATCHER_ACCOUNT=watcher-browser
Environment=FPL_SCHEME=falcon-512
Environment=FPL_NETWORK_ID=2300
Environment=BTC_EXPLORER=https://mempool.space/testnet/api
Environment=STATE_PATH=/home/falcon/falcon-pl-public-testnet-2300/run/btc-headers.json
Environment=POLL_SEC=20
ExecStart=/usr/bin/python3 /home/falcon/falcon-pl-public-testnet-2300/scripts/pl-btc-header-submitter.py
Restart=always
RestartSec=15
StandardOutput=append:/home/falcon/falcon-pl-public-testnet-2300/logs/btc-header-submitter.log
StandardError=append:/home/falcon/falcon-pl-public-testnet-2300/logs/btc-header-submitter.log

[Install]
WantedBy=multi-user.target
