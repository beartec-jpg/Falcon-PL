[Unit]
Description=Falcon PL 2300 Sepolia ETH light-client relayer
After=network.target

[Service]
Type=simple
User=falcon
WorkingDirectory=/home/falcon/falcon-pl-public-testnet-2300
EnvironmentFile=-/home/falcon/falcon-pl-public-testnet-2300/run/bridge/falcon-pl-bridge.env
# Dedicated LC account. Not watcher-browser (BTC) and not watcher-eth (auto-mint).
Environment=FPL_WATCHER_ACCOUNT=watcher-eth-lc
Environment=POLL_SEC=10
Environment=POLL_SEC_BEHIND=5
Environment=PACK_WAIT_TRIES=90
ExecStart=/usr/bin/python3 /home/falcon/falcon-pl-public-testnet-2300/scripts/pl-eth-lc-relayer.py daemon
Restart=always
RestartSec=5
# Wrong signer exits 78. Do not restart-loop a bad account.conf drop-in.
RestartPreventExitStatus=78
StandardOutput=append:/home/falcon/falcon-pl-public-testnet-2300/logs/eth-lc-relayer.log
StandardError=append:/home/falcon/falcon-pl-public-testnet-2300/logs/eth-lc-relayer.log

[Install]
WantedBy=multi-user.target
