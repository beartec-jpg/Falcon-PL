[Unit]
Description=Falcon PL Falcon-512 QC prover B (second submit account)
After=network-online.target falcon-pl-node.service
Wants=network-online.target

[Service]
Type=simple
User=falcon
WorkingDirectory=/home/falcon/falcon-pl-public-testnet-2300
EnvironmentFile=-/home/falcon/falcon-pl-public-testnet-2300/run/bridge/falcon-pl-bridge.env
Environment=FALCON_QC_PK=/home/falcon/falcon-pl-public-testnet-2300/run/snark/falcon-qc-one/pk.bin
Environment=FALCON_QC_KEYS=/home/falcon/falcon-pl-public-testnet-2300/keys/falcon-qc
Environment=FALCON_QC_SIGS=/home/falcon/falcon-pl-public-testnet-2300/keys/falcon-qc/sigs
Environment=FALCON_QC_PROVER_DIR=/home/falcon/falcon-pl-public-testnet-2300/run/snark/falcon-qc-prover-b
Environment=FALCON_QC_SAMPLE_GAP=48
Environment=FALCON_QC_THRESHOLD=4
Environment=FALCON_QC_PROVE_PARALLEL=1
Environment=FALCON_QC_STEADY=1
Environment=POLL_SEC=11
Environment=ETH_SUBMIT_PK_FILE=/home/falcon/falcon-pl-vault-test/eth-wallets/submit-b.privhex
MemoryMax=32G
ExecStart=/usr/bin/python3 /home/falcon/falcon-pl-public-testnet-2300/scripts/pl-falcon-qc-prover.py
Restart=always
RestartSec=20
StandardOutput=append:/home/falcon/falcon-pl-public-testnet-2300/logs/falcon-qc-prover-b.log
StandardError=append:/home/falcon/falcon-pl-public-testnet-2300/logs/falcon-qc-prover-b.log

[Install]
WantedBy=multi-user.target
