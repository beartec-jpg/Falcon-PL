[Unit]
Description=Falcon PL Falcon-512 QC v2 prover (sequential FalconQcBridgeV2 headers)
After=network-online.target falcon-pl-node.service
Wants=network-online.target

[Service]
Type=simple
User=falcon
WorkingDirectory=/home/falcon/falcon-pl-public-testnet-2300
EnvironmentFile=-/home/falcon/falcon-pl-public-testnet-2300/run/bridge/falcon-pl-bridge.env
Environment=FALCON_QC_PK=/home/falcon/falcon-pl-public-testnet-2300/run/snark/falcon-qc-v2-one/pk.bin
Environment=FALCON_QC_KEYS=/home/falcon/falcon-pl-public-testnet-2300/keys/falcon-qc
Environment=FALCON_QC_SIGS=/home/falcon/falcon-pl-public-testnet-2300/keys/falcon-qc/sigs-v2
Environment=FALCON_QC_THRESHOLD=4
Environment=FALCON_QC_PROVE_PARALLEL=1
Environment=FALCON_QC_PROVE_WORKERS=4
Environment=FALCON_QC_PROVE_AHEAD=8
Environment=FALCON_QC_LEASE_DIR=/home/falcon/falcon-pl-public-testnet-2300/run/snark/falcon-qc-v2-prover/leases
Environment=ETH_PK_FILE=/home/falcon/falcon-pl-vault-test/eth-wallets/deployer.privhex
Environment=POLL_SEC=8
# 4-host farm is keep-up. One host is lagged unwrap, not a 32-height SLA.
MemoryMax=32G
ExecStart=/usr/bin/python3 /home/falcon/falcon-pl-public-testnet-2300/scripts/pl-falcon-qc-v2-prover.py
Restart=always
RestartSec=20
StandardOutput=append:/home/falcon/falcon-pl-public-testnet-2300/logs/falcon-qc-v2-prover.log
StandardError=append:/home/falcon/falcon-pl-public-testnet-2300/logs/falcon-qc-v2-prover.log

[Install]
WantedBy=multi-user.target
