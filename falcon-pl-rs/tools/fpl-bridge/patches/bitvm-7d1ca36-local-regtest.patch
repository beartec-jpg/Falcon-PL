     match network {
         Network::Bitcoin => mainnet_num_blocks,
-        Network::Regtest => NUM_BLOCKS_REGTEST,
+        Network::Regtest | Network::Signet => match fpl_regtest_divisor() {
+            Some(d) => fpl_scaled_timelock(mainnet_num_blocks, d),
+            None => NUM_BLOCKS_REGTEST,
+        },
+        Network::Testnet4 if cfg!(feature = "fpl-tn4-timelocks") => {
+            fpl_scaled_timelock(mainnet_num_blocks, FPL_TN4_TIMELOCK_DIVISOR)
+        }
         _ => NUM_BLOCKS_TESTNET, // Testnet, Signet
     }
 }
 
+#[cfg(test)]
+mod fpl_timelock_tests {
+    use super::*;
+    use crate::constants::*;
+    #[test]
+    fn scaled_timelocks_keep_order_and_window() {
+        let s = |b| fpl_scaled_timelock(b, FPL_TN4_TIMELOCK_DIVISOR);
+        assert_eq!(s(NUM_BLOCKS_PER_2_WEEKS), 72);
+        assert_eq!(s(NUM_BLOCKS_PER_2_WEEKS + NUM_BLOCKS_PER_DAY), 78);
+        assert_eq!(s(NUM_BLOCKS_PER_3_DAYS), 16);
+        assert_eq!(s(NUM_BLOCKS_PER_6_HOURS), 2);
+        assert!(s(NUM_BLOCKS_PER_2_WEEKS + NUM_BLOCKS_PER_DAY) > s(NUM_BLOCKS_PER_2_WEEKS));
+        assert_eq!(num_blocks_per_network(Network::Bitcoin, NUM_BLOCKS_PER_2_WEEKS), 2016);
+        let tn4 = num_blocks_per_network(Network::Testnet4, NUM_BLOCKS_PER_2_WEEKS);
+        assert_eq!(tn4, if cfg!(feature = "fpl-tn4-timelocks") { 72 } else { 2 });
+        assert_eq!(num_blocks_per_network(Network::Testnet, NUM_BLOCKS_PER_2_WEEKS), 2);
