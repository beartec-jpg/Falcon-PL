+/// FPL M3: dishonest operator (invalid proof, withdrawal not valid on L2) is
+/// challenged and disproved by a permissionless watcher holding no bridge
+/// key. The oversize disprove goes via the own-miner RPC channel
+/// (acceptnonstdtxn node), never standard relay.
+#[tokio::test]
+#[serial]
+async fn test_fpl_watcher_disproves_dishonest_operator() {
+    use bridge::fpl_watcher::{self, GraphWatchState, SubmitChannel, SubmitConfig, WatchAction, WatcherIdentity};
+    let (mut c, peg_in_graph_id, peg_out_graph_id) = fpl_ceremony_setup().await;
+    c.client.broadcast_peg_in_confirm(&peg_in_graph_id).await.expect("peg-in confirm");
+    wait_for_confirmation_with_message(c.client.source_network, Some("peg-in confirm")).await;
+    simulate_peg_out_from_l2(&mut c.client, &peg_out_graph_id, &c.operator_context, &c.withdrawer_evm_address.clone(), &c.withdrawer_context).await;
+
+    // watcher identity: fresh key, small hot wallet, no bridge role
+    let wk = bitcoin::key::Keypair::new(bitcoin::secp256k1::SECP256K1, &mut bitcoin::secp256k1::rand::thread_rng());
+    let wpub = bitcoin::PublicKey::new(wk.public_key());
+    let w_addr = generate_pay_to_pubkey_script_address(c.client.source_network, &wpub);
+    let w_amt = Amount::from_btc(1.0).unwrap();
+    Faucet::new(FaucetType::EsploraRegtest).fund_input(&w_addr, w_amt).await.wait().await;
+    let w_out = generate_stub_outpoint(&c.client, &w_addr, w_amt).await;
+    let w_script = generate_pay_to_pubkey_script(&wpub);
+    let who = WatcherIdentity {
+        challenge_inputs: vec![InputWithScript { outpoint: w_out, amount: w_amt, script: &w_script }],
+        challenge_keypair: wk,
+        reward_spk: w_script.clone(),
+    };
+    let cfg = SubmitConfig {
+        standard: vec![SubmitChannel::Esplora { url: std::env::var("FPL_ESPLORA_URL").unwrap_or("http://127.0.0.1:8094/regtest/api".into()) }],
+        nonstandard: vec![
+            SubmitChannel::MinerHttp { name: "unreachable-pool".into(), url: "http://127.0.0.1:9/submit".into(), auth_env: None, content_type: "text/plain".into() },
+            SubmitChannel::BitcoindRpc { name: "own-miner".into(), url: "http://127.0.0.1:18543".into(), user_env: "FPL_MINER_RPC_USER".into(), pass_env: "FPL_MINER_RPC_PASS".into() },
+        ],
+    };
+    let vk = crate::bridge::helper::get_valid_proof().vk;
+    let mut wgraph = c.client.data().peg_out_graphs.iter().find(|g| bridge::graphs::base::BaseGraph::id(*g) == &peg_out_graph_id).unwrap().clone();
+    let mut st = GraphWatchState::default();
+
+    // operator kicks off a withdrawal that is NOT valid on L2
+    c.client.broadcast_kick_off_1(&peg_out_graph_id).await.expect("kick-off 1");
+    wait_for_confirmation_with_message(c.client.source_network, Some("kick-off 1")).await;
+    let a = fpl_watcher::step(&c.client.esplora, &mut wgraph, &vk, &cfg, &who, false, &mut st).await;
+    println!("watcher step 1: {a:?} {:?}", st.log);
+    assert_eq!(a, WatchAction::Challenge);
+    assert!(st.challenged, "challenge not accepted");
+    wait_for_confirmation_with_message(c.client.source_network, Some("challenge")).await;
+
+    // operator continues with an invalid proof
+    wait_for_timelock_expiry(c.client.source_network, Some("kick-off 1 connector 1")).await;
+    c.client.broadcast_start_time(&peg_out_graph_id).await.expect("start time");
+    wait_for_confirmation_with_message(c.client.source_network, Some("start time")).await;
+    c.client.broadcast_kick_off_2(&peg_out_graph_id).await.expect("kick-off 2");
+    wait_for_timelock_expiry(c.client.source_network, Some("kick-off 2 connector b")).await;
+    let invalid = crate::bridge::helper::invalidate_proof(&crate::bridge::helper::get_valid_proof());
+    c.client.broadcast_assert_initial(&peg_out_graph_id).await.expect("assert initial");
+    wait_for_confirmation_with_message(c.client.source_network, Some("assert initial")).await;
+    c.client.broadcast_assert_commits(&peg_out_graph_id, &invalid).await.expect("assert commits");
+    wait_for_confirmation_with_message(c.client.source_network, Some("assert commits")).await;
+    wait_for_confirmation_with_message(c.client.source_network, Some("assert commits")).await;
+    c.client.broadcast_assert_final(&peg_out_graph_id).await.expect("assert final");
+    wait_for_timelock_expiry(c.client.source_network, Some("assert final connector 4")).await;
+
+    let mut disproved = false;
+    for i in 0..10 {
+        let a = fpl_watcher::step(&c.client.esplora, &mut wgraph, &vk, &cfg, &who, false, &mut st).await;
+        println!("watcher step {}: {a:?}", i + 2);
+        if a == WatchAction::Done { disproved = true; break; }
+        wait_for_confirmation_with_message(c.client.source_network, Some("watcher")).await;
+    }
+    for l in &st.log { println!("watcher log: {l}"); }
+    assert!(disproved, "disprove not mined");
+    let t = wgraph.fpl_watch_txids();
+    assert!(c.client.esplora.get_tx_status(&t.disprove).await.unwrap().confirmed);
+    assert!(!c.client.esplora.get_tx_status(&t.take_2).await.unwrap().confirmed);
+    println!("FPL watcher: dishonest operator challenged + disproved via own-miner channel PASS");
+}
