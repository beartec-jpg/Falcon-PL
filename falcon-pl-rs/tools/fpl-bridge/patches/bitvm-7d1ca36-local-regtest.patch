+/// Operator-timeout acceptance (2-key depositor+signer graph): operator posts
+/// kickoff 1 then stalls; anyone can burn/claim via the presigned timeouts.
+async fn fpl_operator_stall(which: &str) {
+    let (mut c, peg_in_graph_id, peg_out_graph_id) = fpl_ceremony_setup().await;
+    c.client.broadcast_peg_in_confirm(&peg_in_graph_id).await.expect("peg-in confirm");
+    wait_for_confirmation_with_message(c.client.source_network, Some("peg-in confirm")).await;
+    simulate_peg_out_from_l2(&mut c.client, &peg_out_graph_id, &c.operator_context,
+        &c.withdrawer_evm_address.clone(), &c.withdrawer_context).await;
+    broadcast_transactions_from_peg_out_graph(&mut c.client, &peg_out_graph_id,
+        &c.depositor_context, false, false, None).await;
+    c.client.sync().await;
+    let spk = generate_pay_to_pubkey_script(&c.depositor_context.depositor_public_key);
+    let r = if which == "start_time" {
+        c.client.broadcast_start_time_timeout(&peg_out_graph_id, spk).await
+    } else {
+        c.client.broadcast_kick_off_timeout(&peg_out_graph_id, spk).await
+    };
+    r.expect("operator timeout tx failed");
+    wait_for_confirmation_with_message(c.client.source_network, Some("timeout")).await;
+    // operator can no longer take
+    assert!(c.client.broadcast_take_1(&peg_out_graph_id).await.is_err());
+    println!("FPL acceptance: operator stalled -> {which} timeout mined, take1 impossible PASS");
+}
