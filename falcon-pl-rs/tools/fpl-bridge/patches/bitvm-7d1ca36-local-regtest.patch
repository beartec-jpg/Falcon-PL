+/// Depositor-signed deposit (design 2026-10-18 07:51): the n-of-n for this
+/// deposit's graph = {depositor wallet ephemeral key, FPL signer ephemeral
+/// key}; both RAM-only, wiped after signing. No standing keys anywhere.
+/// `depositor_signs=false`: the depositor announces a key but walks away.
+async fn fpl_deposit_signing(depositor_signs: bool) -> (crate::bridge::setup::FplCeremonyCoordinator, String, String, bool) {
+    use bridge::fpl_ceremony;
+    use std::time::Duration;
+    let dir = std::env::temp_dir().join(format!("fpl_ceremony_{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let ids: Vec<String> = vec!["depositor-wallet".into(), "fpl-signer".into()];
+    let timeout = Duration::from_secs(if depositor_signs { 1800 } else { 20 });
+
+    let mut handles = vec![];
+    for id in &ids {
+        let (d, id) = (dir.clone(), id.clone());
+        if id == "depositor-wallet" && !depositor_signs {
+            // announces an ephemeral key, then never signs
+            let k = bitcoin::key::Keypair::new(bitcoin::secp256k1::SECP256K1, &mut bitcoin::secp256k1::rand::thread_rng());
+            std::fs::create_dir_all(d.join("pub")).unwrap();
+            std::fs::write(d.join("pub").join("depositor-wallet.json"), serde_json::to_vec(&fpl_ceremony::PubAnnouncement { id: id.clone(), public_key: bitcoin::PublicKey::new(k.public_key()) }).unwrap()).unwrap();
+            continue;
+        }
+        handles.push(std::thread::spawn(move || fpl_ceremony::participant(&d, &id, timeout)));
+    }
+
+    let pubs = fpl_ceremony::collect_pubkeys(&dir, ids.len(), timeout).unwrap();
+    let n_of_n: Vec<bitcoin::PublicKey> = pubs.iter().map(|p| p.public_key).collect();
+    let mut c = crate::bridge::setup::fpl_ceremony_coordinator(&n_of_n).await;
+
+    let deposit_input_amount = Amount::from_sat(INITIAL_AMOUNT + PEG_IN_FEE);
+    let deposit_funding_address = generate_pay_to_pubkey_script_address(
+        c.depositor_context.network,
+        &c.depositor_context.depositor_public_key,
+    );
+    let kick_off_input_amount = Amount::from_sat(INITIAL_AMOUNT + PEG_OUT_FEE);
+    let kick_off_funding_utxo_address = generate_pay_to_pubkey_script_address(
+        c.operator_context.network,
+        &c.operator_context.operator_public_key,
+    );
+    let funding_inputs = vec![
+        (&deposit_funding_address, deposit_input_amount),
+        (&kick_off_funding_utxo_address, kick_off_input_amount),
+    ];
+    Faucet::new(FaucetType::EsploraRegtest)
+        .fund_inputs(&c.client, &funding_inputs)
+        .await
+        .wait()
+        .await;
+    let kick_off_outpoint =
+        generate_stub_outpoint(&c.client, &kick_off_funding_utxo_address, kick_off_input_amount).await;
+    let peg_in_graph_id = create_peg_in_graph(
+        &mut c.client,
+        deposit_funding_address,
+        deposit_input_amount,
+        &c.depositor_evm_address.clone(),
+    )
+    .await;
+    let peg_out_graph_id = c.client.create_peg_out_graph(
+        &peg_in_graph_id,
+        Input { outpoint: kick_off_outpoint, amount: kick_off_input_amount },
+        c.commitment_secrets.clone(),
+    );
+
+    fpl_ceremony::publish_graphs(
+        &dir,
+        &fpl_ceremony::GraphsFile {
+            network: c.client.source_network,
+            n_of_n_public_keys: n_of_n.clone(),
+            signing_order: ids.clone(),
+            data: c.client.data().clone(),
+        },
+    );
+    match fpl_ceremony::coordinate(&dir, &ids, timeout) {
+        Ok((signed, atts)) => {
+            for h in handles {
+                let a = h.join().unwrap().expect("participant failed");
+                assert!(a.verify());
+            }
+            assert_eq!(atts.len(), ids.len());
+            println!("FPL deposit signing: depositor + FPL signer ephemeral keys, {} deletion attestations verified", atts.len());
+            c.client.merge_data(signed);
+            (c, peg_in_graph_id, peg_out_graph_id, true)
+        }
+        Err(e) => {
+            println!("FPL deposit signing incomplete: {e}");
+            (c, peg_in_graph_id, peg_out_graph_id, false)
+        }
+    }
+}
