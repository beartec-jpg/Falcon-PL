+/// FPL patch: "fplraw:<key>" passes a WinternitzSecret (bridge `secret_key` bytes, ASCII hex)
+/// through unchanged. Bridge graphs built by the ceremony hold random secret keys whose
+/// un-hexed bytes are not UTF-8, so the upstream `secret_from_str(s)` (= hex(s)) cannot
+/// express them; every other string keeps the upstream conversion.
+#[allow(deprecated)]
+pub(crate) fn fpl_wots_secret(s: &str) -> crate::signatures::WinternitzSecret {
+    use crate::signatures::Wots;
+    match s.strip_prefix("fplraw:") {
+        Some(k) => k.as_bytes().to_vec(),
+        None => crate::signatures::Wots32::secret_from_str(s),
+    }
+}
