+/// Acceptance: without the depositor's key nobody can move the deposit.
+/// The depositor walks away before signing: the graph cannot be completed,
+/// the peg-in confirm (into the n-of-n) cannot be produced by anyone else,
+/// and the depositor alone reclaims the deposit via the refund path.
+#[tokio::test]
+#[serial]
+async fn test_fpl_depositor_absent_nobody_can_move_funds() {
+    let (mut c, peg_in_graph_id, _peg_out, ok) = fpl_deposit_signing(false).await;
+    assert!(!ok, "signing must not complete without the depositor");
+    let r = c.client.broadcast_peg_in_confirm(&peg_in_graph_id).await;
+    println!("peg-in confirm without depositor signature: {:?}", r.as_ref().err());
+    assert!(r.is_err(), "peg-in confirm must not be broadcastable without the depositor's signature");
+    // the deposit output's refund leaf is depositor-only after its timelock
+    let mut refunded = false;
+    for _ in 0..120 {
+        match c.client.broadcast_peg_in_refund(&peg_in_graph_id).await {
+            Ok(txid) => { println!("depositor refund {txid}"); refunded = true; break; }
+            Err(_) => wait_for_confirmation_with_message(c.client.source_network, Some("refund timelock")).await,
+        }
+    }
+    assert!(refunded, "depositor refund failed");
+    println!("FPL acceptance: depositor absent -> no one moved funds; depositor refunded PASS");
+}
