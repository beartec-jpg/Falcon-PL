+/// FPL patch: coordinator client for the per-machine ceremony. Holds only the
+/// depositor + operator roles (no verifier key); the n-of-n keys come from
+/// the ceremony participants.
+pub struct FplCeremonyCoordinator {
+    pub client: BitVMClient,
+    pub depositor_context: DepositorContext,
+    pub operator_context: OperatorContext,
+    pub withdrawer_context: WithdrawerContext,
+    pub commitment_secrets: HashMap<CommitmentMessageId, WinternitzSecret>,
+    pub depositor_evm_address: String,
+    pub withdrawer_evm_address: String,
+}
+
+pub async fn fpl_ceremony_coordinator(n_of_n_public_keys: &[PublicKey]) -> FplCeremonyCoordinator {
+    let source_network = Network::Regtest;
+    let destination_network = DestinationNetwork::Local;
+    let valid_proof = get_valid_proof();
+    let client = BitVMClient::new(
+        Some(get_esplora_url(source_network)),
+        source_network,
+        destination_network,
+        Some(get_chain_adaptor(destination_network, None, None)),
+        n_of_n_public_keys,
+        Some(DEPOSITOR_SECRET),
+        Some(OPERATOR_SECRET),
+        None,
+        Some(WITHDRAWER_SECRET),
+        Some("fpl_ceremony_coordinator"),
+        Some(valid_proof.vk.clone()),
+    )
+    .await;
+    FplCeremonyCoordinator {
+        client,
+        depositor_context: DepositorContext::new(source_network, DEPOSITOR_SECRET, n_of_n_public_keys),
+        operator_context: OperatorContext::new(source_network, OPERATOR_SECRET, n_of_n_public_keys),
+        withdrawer_context: WithdrawerContext::new(source_network, WITHDRAWER_SECRET, n_of_n_public_keys),
+        commitment_secrets: get_test_commitment_secrets(),
+        depositor_evm_address: DEPOSITOR_EVM_ADDRESS.to_string(),
+        withdrawer_evm_address: WITHDRAWER_EVM_ADDRESS.to_string(),
+    }
+}
