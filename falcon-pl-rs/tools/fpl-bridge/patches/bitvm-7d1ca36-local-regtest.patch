+    /// FPL browser-depositor mode: unsigned peg-in graph from the depositor's
+    /// PUBLIC key only (the depositor key never reaches the coordinator).
+    pub fn fpl_new_external(
+        network: Network,
+        depositor_public_key: &PublicKey,
+        n_of_n_public_keys: &[PublicKey],
+        depositor_evm_address: &str,
+        deposit_input: Input,
+    ) -> Self {
+        let (nn, nnx) = crate::contexts::base::generate_n_of_n_public_key(n_of_n_public_keys);
+        create_graph_without_signing(
+            network,
+            depositor_public_key,
+            &XOnlyPublicKey::from(*depositor_public_key),
+            &nn,
+            n_of_n_public_keys,
+            &nnx,
+            depositor_evm_address,
+            deposit_input,
+        )
+    }
+
+    /// The three depositor signing requests as PSBTs (hex) plus the exact
+    /// sighash each signature must commit to: deposit (P2WSH <pk> CHECKSIG,
+    /// ECDSA, SIGHASH_ALL), refund + confirm (tapscript leaf of connector Z,
+    /// BIP340, SIGHASH_ALL).
+    pub fn fpl_depositor_requests(&self) -> Result<Vec<(String, String, String)>, String> {
+        use bitcoin::sighash::{Prevouts, SighashCache};
+        use bitcoin::taproot::{LeafVersion, TapLeafHash};
+        let mut out = vec![];
+        // deposit
+        let d = &self.peg_in_deposit_transaction;
+        let ws = d.prev_scripts()[0].clone();
+        let amt = d.prev_outs()[0].value;
+        let sh = SighashCache::new(d.tx())
+            .p2wsh_signature_hash(0, &ws, amt, bitcoin::EcdsaSighashType::All)
+            .map_err(|e| e.to_string())?;
+        let mut ps = bitcoin::Psbt::from_unsigned_tx(strip(d.tx())).map_err(|e| e.to_string())?;
+        ps.inputs[0].witness_utxo = Some(d.prev_outs()[0].clone());
+        ps.inputs[0].witness_script = Some(ws);
+        ps.inputs[0].sighash_type = Some(bitcoin::EcdsaSighashType::All.into());
+        out.push(("deposit".into(), b64(&ps), sh.to_string()));
+        // refund + confirm: tapscript leaves of connector Z
+        use crate::connectors::base::TaprootConnector;
+        let info = self.connector_z.generate_taproot_spend_info();
+        for (name, tx, prev_outs, script) in [
+            ("refund", self.peg_in_refund_transaction.tx(), self.peg_in_refund_transaction.prev_outs(), self.peg_in_refund_transaction.prev_scripts()[0].clone()),
+            ("confirm", self.peg_in_confirm_transaction.tx(), self.peg_in_confirm_transaction.prev_outs(), self.peg_in_confirm_transaction.prev_scripts()[0].clone()),
+        ] {
+            let leaf = TapLeafHash::from_script(&script, LeafVersion::TapScript);
+            let sh = SighashCache::new(tx)
+                .taproot_script_spend_signature_hash(0, &Prevouts::All(prev_outs), leaf, bitcoin::TapSighashType::All)
+                .map_err(|e| e.to_string())?;
+            let cb = info
+                .control_block(&(script.clone(), LeafVersion::TapScript))
+                .ok_or("no control block for depositor leaf")?;
+            let mut ps = bitcoin::Psbt::from_unsigned_tx(strip(tx)).map_err(|e| e.to_string())?;
+            ps.inputs[0].witness_utxo = Some(prev_outs[0].clone());
+            ps.inputs[0].tap_internal_key = Some(info.internal_key());
+            ps.inputs[0].tap_merkle_root = info.merkle_root();
+            ps.inputs[0].tap_scripts.insert(cb, (script, LeafVersion::TapScript));
+            ps.inputs[0].sighash_type = Some(bitcoin::TapSighashType::All.into());
+            out.push((name.into(), b64(&ps), sh.to_string()));
+        }
+        Ok(out)
+    }
+
+    /// Attach the depositor's signatures (each verified against its sighash
+    /// and the depositor key first) -> the signed peg-in graph.
+    pub fn fpl_with_depositor_signatures(&self, deposit: bitcoin::ecdsa::Signature, refund: bitcoin::taproot::Signature, confirm: bitcoin::taproot::Signature) -> Result<Self, String> {
+        let secp = bitcoin::secp256k1::Secp256k1::verification_only();
+        use bitcoin::hashes::Hash;
+        let dep_msg = {
+            use bitcoin::sighash::SighashCache;
+            let d = &self.peg_in_deposit_transaction;
+            let sh = SighashCache::new(d.tx()).p2wsh_signature_hash(0, &d.prev_scripts()[0], d.prev_outs()[0].value, bitcoin::EcdsaSighashType::All).map_err(|e| e.to_string())?;
+            bitcoin::secp256k1::Message::from_digest(sh.to_byte_array())
+        };
+        if deposit.sighash_type != bitcoin::EcdsaSighashType::All {
+            return Err("deposit signature must be SIGHASH_ALL".into());
+        }
+        secp.verify_ecdsa(&dep_msg, &deposit.signature, &self.depositor_public_key.inner)
+            .map_err(|_| "deposit signature does not verify")?;
+        for (sig, tx, prev_outs, script, name) in [
+            (&refund, self.peg_in_refund_transaction.tx(), self.peg_in_refund_transaction.prev_outs(), &self.peg_in_refund_transaction.prev_scripts()[0], "refund"),
+            (&confirm, self.peg_in_confirm_transaction.tx(), self.peg_in_confirm_transaction.prev_outs(), &self.peg_in_confirm_transaction.prev_scripts()[0], "confirm"),
+        ] {
+            use bitcoin::sighash::{Prevouts, SighashCache};
+            use bitcoin::taproot::{LeafVersion, TapLeafHash};
+            if sig.sighash_type != bitcoin::TapSighashType::All {
+                return Err(format!("{name} signature must be SIGHASH_ALL"));
+            }
+            let sh = SighashCache::new(tx)
+                .taproot_script_spend_signature_hash(0, &Prevouts::All(prev_outs), TapLeafHash::from_script(script, LeafVersion::TapScript), bitcoin::TapSighashType::All)
+                .map_err(|e| e.to_string())?;
+            secp.verify_schnorr(&sig.signature, &bitcoin::secp256k1::Message::from_digest(sh.to_byte_array()), &self.depositor_taproot_public_key)
+                .map_err(|_| format!("{name} signature does not verify"))?;
+        }
+        let sigs = crate::client::sdk::query_contexts::depositor_signatures::DepositorSignatures { deposit, refund, confirm };
+        let g = Self::new_with_depositor_signatures(
+            self.network,
+            &self.depositor_public_key,
+            &self.depositor_taproot_public_key,
+            &self.n_of_n_public_key,
+            &self.n_of_n_public_keys,
+            &self.n_of_n_taproot_public_key,
+            &self.depositor_evm_address,
+            Input {
+                outpoint: self.peg_in_deposit_transaction.tx().input[0].previous_output,
+                amount: self.peg_in_deposit_transaction.prev_outs()[0].value,
+            },
+            &sigs,
+        );
+        if g.id() != self.id() {
+            return Err("signed graph id differs from the prepared graph".into());
+        }
+        Ok(g)
+    }
+
+    pub fn fpl_n_of_n_public_keys(&self) -> &[PublicKey] {
+        &self.n_of_n_public_keys
+    }
