+/// BRIDGE refusal rule on regtest: after a real 2-party presign, the guarded
+/// peg-in confirm is REFUSED (nothing broadcast) when the operator graph is
+/// unbound, bound with mismatched txids, or bound by the wrong account; it goes
+/// through once the ledger status shows the matching binding.
+#[tokio::test]
+#[serial]
+async fn test_fpl_peg_in_refused_unless_graphs_bound() {
+    use bridge::fpl_bindings::{self, Verdict};
+    use std::str::FromStr;
+    let (mut c, peg_in_graph_id, _peg_out_graph_id) = fpl_ceremony_setup().await;
+    let keys = fpl_bindings::graph_keys(c.client.data(), &peg_in_graph_id).unwrap();
+    assert_eq!(keys.len(), 1, "one operator graph for this deposit");
+    let (dep, x, k2, af) = keys[0].clone();
+    println!("BINDING graph: deposit {dep} operator {x} kick_off_2 {k2} assert_final {af}");
+    let ok = fpl_bindings::bound_status_for(&keys, &["op1"]);
+    let key = format!("{dep}:{x}");
+    let esplora = c.client.esplora.clone();
+    let on_chain = |txid: String| {
+        let e = esplora.clone();
+        async move { e.get_tx(&bitcoin::Txid::from_str(&txid).unwrap()).await.ok().flatten().is_some() }
+    };
+
+    let mut unbound = ok.clone();
+    unbound["body"]["bridge_operators"]["graphs"] = serde_json::json!({});
+    let mut mismatch = ok.clone();
+    mismatch["body"]["bridge_operators"]["graphs"][&key]["assert_final_txid"] = serde_json::json!("00".repeat(32));
+    let mut wrong_acct = ok.clone();
+    wrong_acct["body"]["bridge_operators"]["graphs"][&key]["account"] = serde_json::json!("mallory");
+    for (name, st) in [("unbound", &unbound), ("mismatch", &mismatch), ("wrong account", &wrong_acct)] {
+        let e = fpl_bindings::broadcast_peg_in_confirm_checked(&mut c.client, &peg_in_graph_id, st).await.unwrap_err();
+        assert!(e.starts_with("REFUSE"), "{name}: {e}");
+        println!("BINDING {name}: {e}");
+        tokio::time::sleep(std::time::Duration::from_secs(2)).await;
+        assert!(!on_chain(dep.clone()).await, "{name}: peg-in confirm must not be broadcast");
+    }
+    assert_eq!(fpl_bindings::check_peg_in(c.client.data(), &peg_in_graph_id, &serde_json::json!({})), Ok(Verdict::Inactive));
+    let txid = fpl_bindings::broadcast_peg_in_confirm_checked(&mut c.client, &peg_in_graph_id, &ok).await.expect("bound graph: confirm goes through");
+    assert_eq!(txid.to_string(), dep);
+    wait_for_confirmation_with_message(c.client.source_network, Some("peg-in confirm")).await;
+    assert!(on_chain(dep.clone()).await);
+    println!("FPL binding gate: unbound / mismatched / wrong-account refused, bound accepted PASS");
+}
