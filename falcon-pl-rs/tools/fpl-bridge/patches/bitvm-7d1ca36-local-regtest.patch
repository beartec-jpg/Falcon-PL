diff --git a/bridge/src/fpl_binding.rs b/bridge/src/fpl_binding.rs
new file mode 100644
index 0000000..b25b406
--- /dev/null
+++ b/bridge/src/fpl_binding.rs
@@ -0,0 +1,167 @@
+//! FPL patch: SHA256 binding disprove leaf (decision 2026-10-18).
+//!
+//! The Groth16 public input x must equal
+//!   SHA256("FPL3" || txid_display[32] || binding_commit[32]) with the top 3
+//!   bits cleared, where txid_display is the peg-out txid in RPC/display byte
+//!   order and binding_commit = SHA256(withdraw_commit || checkpoint).
+//! Kick-off 1 already Winternitz-commits the peg-out txid (internal byte
+//! order) in the PegOutTxIdSourceNetwork slot; FPL makes the operator commit
+//! reverse(binding_commit) in the PegOutTxIdDestinationNetwork slot. Both
+//! layouts put the bytes on the stack in natural nibble order, which is what
+//! the BitVM u4 SHA256 script consumes. Bitcoin has no OP_CAT, so the hash of
+//! the concatenation is computed in script (sha256_u4, 2 blocks).
+//!
+//! The leaf succeeds (anyone can claim the deposit-protecting output) iff
+//! the committed x differs from the recomputed value.
+use bitvm::signatures::signing_winternitz::{WinternitzPublicKey, WINTERNITZ_MESSAGE_VERIFIER};
+use bitvm::signatures::{Wots, Wots32};
+use bitvm::treepp::{script, Script};
+
+pub const FPL3_NIBBLES: [u8; 8] = [4, 6, 5, 0, 4, 12, 3, 3];
+
+fn mask_low_bit() -> Script {
+    script! {
+        OP_DUP 8 OP_GREATERTHANOREQUAL OP_IF 8 OP_SUB OP_ENDIF
+        OP_DUP 4 OP_GREATERTHANOREQUAL OP_IF 4 OP_SUB OP_ENDIF
+        OP_DUP 2 OP_GREATERTHANOREQUAL OP_IF 2 OP_SUB OP_ENDIF
+    }
+}
+
+/// Verify a kickoff message WOTS sig (64-byte params, 32-byte message) and
+/// move the 64 message nibbles to the altstack (dropping 64 padding digits).
+fn kickoff_msg_to_alt(pk: &WinternitzPublicKey) -> Script {
+    script! {
+        { WINTERNITZ_MESSAGE_VERIFIER.checksig_verify(&pk.parameters, &pk.public_key) }
+        for _ in 0..64 { 64 OP_ROLL OP_DROP }
+        for _ in 0..64 { OP_TOALTSTACK }
+    }
+}
+
+/// Witness (bottom..top): sig_txid, sig_binding, sig_x.
+pub fn binding_disprove_script(
+    x_pk: &<Wots32 as Wots>::PublicKey,
+    txid_pk: &WinternitzPublicKey,
+    binding_pk: &WinternitzPublicKey,
+) -> Script {
+    script! {
+        { Wots32::checksig_verify(x_pk) }
+        for _ in 0..64 { OP_TOALTSTACK }          // alt top: least significant nibble of x
+        { kickoff_msg_to_alt(binding_pk) }
+        { kickoff_msg_to_alt(txid_pk) }
+        for n in FPL3_NIBBLES { { n as u32 } }
+        for _ in 0..128 { OP_FROMALTSTACK }        // txid nibbles, then binding nibbles
+        { bitvm::hash::sha256_u4::sha256(68) }
+        // compare h63..h0 against x (alt), masking h0 to its low bit
+        OP_FROMALTSTACK OP_EQUAL
+        for i in 1..64 {
+            OP_SWAP
+            if i == 63 { { mask_low_bit() } }
+            OP_FROMALTSTACK OP_EQUAL OP_ADD
+        }
+        64 OP_NUMNOTEQUAL
+    }
+}
+
+/// Native recomputation (same definition as fd-pl-bitvm2 V3).
+pub fn expected_x_be(txid_internal: &[u8; 32], binding_commit: &[u8; 32]) -> [u8; 32] {
+    use sha2::{Digest, Sha256};
+    let mut m = b"FPL3".to_vec();
+    let mut disp = *txid_internal;
+    disp.reverse();
+    m.extend_from_slice(&disp);
+    m.extend_from_slice(binding_commit);
+    let mut h: [u8; 32] = Sha256::digest(&m).into();
+    h[0] &= 0x1f;
+    h
+}
+
+/// The 32-byte message the chunk code signs for a U256 public input whose
+/// big-endian value is `x_be` (inverse of CompressedStateObject::U256
+/// serialisation: byte j = (n[2j+1] << 4) | n[2j], n = BE nibbles).
+pub fn chunk_pub_message(x_be: &[u8; 32]) -> [u8; 32] {
+    let mut n = [0u8; 64];
+    for (i, b) in x_be.iter().enumerate() {
+        n[2 * i] = b >> 4;
+        n[2 * i + 1] = b & 15;
+    }
+    let mut m = [0u8; 32];
+    for j in 0..32 {
+        m[j] = (n[2 * j + 1] << 4) | n[2 * j];
+    }
+    m
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use bitvm::signatures::signing_winternitz::{
+        generate_winternitz_witness, WinternitzSecret, WinternitzSigningInputs,
+    };
+
+    fn run(txid: [u8; 32], binding: [u8; 32], x_be: [u8; 32]) -> (bool, usize, usize) {
+        let ts = WinternitzSecret::from_bytes(64, b"aa01".to_vec());
+        let bs = WinternitzSecret::from_bytes(64, b"bb02".to_vec());
+        let xs = Wots32::secret_from_str("cc03");
+        let (tpk, bpk, xpk) = (WinternitzPublicKey::from(&ts), WinternitzPublicKey::from(&bs), Wots32::generate_public_key(&xs));
+        let mut rb = binding;
+        rb.reverse();
+        let mut wit = generate_winternitz_witness(&WinternitzSigningInputs { message: &txid, signing_key: &ts }).to_vec();
+        wit.extend(generate_winternitz_witness(&WinternitzSigningInputs { message: &rb, signing_key: &bs }).to_vec());
+        wit.extend(Wots32::signature_to_raw_witness(&Wots32::sign(&xs, &chunk_pub_message(&x_be))).to_vec());
+        let sc = binding_disprove_script(&xpk, &tpk, &bpk);
+        let len = sc.clone().compile().len();
+        let r = bitvm::execute_script_with_inputs(sc, wit);
+        (r.success && r.final_stack.len() == 1, r.final_stack.len(), len)
+    }
+
+    #[test]
+    fn honest_binding_cannot_be_disproved() {
+        let txid = [7u8; 32];
+        let mut txid2 = txid; txid2[0] = 1; txid2[31] = 2;
+        let b = [9u8; 32];
+        let x = expected_x_be(&txid2, &b);
+        let (ok, n, len) = run(txid2, b, x);
+        println!("leaf size {len} bytes, final stack {n}");
+        assert!(!ok, "honest commitment must not be disprovable");
+    }
+
+    #[test]
+    fn wrong_txid_is_disproved() {
+        let b = [9u8; 32];
+        let x = expected_x_be(&[1u8; 32], &b); // proof made for another payout
+        let (ok, n, _) = run([2u8; 32], b, x);
+        assert!(ok, "mismatched txid must be disprovable (stack {n})");
+    }
+
+    #[test]
+    fn wrong_binding_is_disproved() {
+        let x = expected_x_be(&[1u8; 32], &[9u8; 32]);
+        let (ok, _, _) = run([1u8; 32], [8u8; 32], x);
+        assert!(ok);
+    }
+}
+
+#[cfg(test)]
+mod chunk_encoding {
+    use super::*;
+    use ark_ff::{BigInteger, PrimeField};
+
+    /// The chunk code's committed pub-input message must equal
+    /// chunk_pub_message(x canonical BE). Needs FPL_PROOF_DIR.
+    #[test]
+    fn chunk_pub_input_encoding_matches() {
+        if std::env::var("FPL_PROOF_DIR").is_err() {
+            eprintln!("skip: FPL_PROOF_DIR unset");
+            return;
+        }
+        let p = crate::proof::get_proof();
+        let n = bitvm::chunk::api::NUM_PUBS + bitvm::chunk::api::NUM_U256 + bitvm::chunk::api::NUM_HASH;
+        let secrets: Vec<String> = (0..n).map(|i| format!("{i:04x}")).collect();
+        let sigs = bitvm::chunk::api::generate_signatures_for_any_proof(p.proof.clone(), p.public.clone(), &p.vk, secrets);
+        let committed = Wots32::signature_to_message(&sigs.0[0]);
+        let xb = p.public[0].into_bigint().to_bytes_be();
+        let mut x_be = [0u8; 32];
+        x_be[32 - xb.len()..].copy_from_slice(&xb);
+        assert_eq!(committed, chunk_pub_message(&x_be), "chunk pub encoding differs");
+    }
+}
diff --git a/bridge/src/fpl_bindings.rs b/bridge/src/fpl_bindings.rs
new file mode 100644
index 0000000..e241474
--- /dev/null
+++ b/bridge/src/fpl_bindings.rs
@@ -0,0 +1,161 @@
+//! FPL BRIDGE refusal rule (depositor / coordinator side).
+//!
+//! Before the peg-in deposit or peg-in confirm of a deposit is broadcast, EVERY
+//! operator peg-out graph built for that peg-in must be bound on the Falcon ledger
+//! (`operator_graph_bind`) by the account that registered that operator's BTC key
+//! (status `Active`), with the same KickOff2 + AssertFinal txids as the presigned
+//! graph. Otherwise the deposit is refused: an unbound graph cannot be slashed, so
+//! its operator could cheat without losing the bond.
+//!
+//! Status source = `falcon-pl-ctl status` JSON (`bridge_operators` section). Enforced
+//! only when the node reports `bridge_operators.active` (the one bridge height); a
+//! node without the section (pre-bridge release) reports `Inactive`.
+//! Read-only: no key is involved anywhere here.
+
+use crate::client::client::BitVMClientPublicData;
+use crate::graphs::base::BaseGraph;
+use serde_json::Value;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Verdict {
+    /// Bridge not active on the ledger yet: rule not enforced.
+    Inactive,
+    /// All `n` operator graphs for the peg-in are bound and match.
+    Bound(usize),
+}
+
+/// (peg-in confirm txid, operator x-only, kick_off_2 txid, assert_final txid) per graph.
+pub type GraphKey = (String, String, String, String);
+
+fn bo(status: &Value) -> &Value {
+    &status.get("body").filter(|b| b.get("bridge_operators").is_some()).unwrap_or(status)["bridge_operators"]
+}
+
+pub fn bridge_active(status: &Value) -> bool {
+    bo(status)["active"].as_bool().unwrap_or(false)
+}
+
+/// Graph keys of every peg-out graph built on `peg_in_id`.
+pub fn graph_keys(data: &BitVMClientPublicData, peg_in_id: &str) -> Result<Vec<GraphKey>, String> {
+    use crate::transactions::pre_signed::PreSignedTransaction;
+    let pi = data
+        .peg_in_graphs
+        .iter()
+        .find(|g| g.id() == peg_in_id)
+        .ok_or_else(|| format!("no peg-in graph {peg_in_id}"))?;
+    let dep = pi.peg_in_confirm_transaction_ref().tx().compute_txid().to_string();
+    let keys: Vec<GraphKey> = data
+        .peg_out_graphs
+        .iter()
+        .filter(|g| g.fpl_peg_in_graph_id() == peg_in_id)
+        .map(|g| {
+            let w = g.fpl_watch_txids();
+            let x = g.fpl_operator_public_key().inner.x_only_public_key().0.to_string();
+            (dep.clone(), x, w.kick_off_2.to_string(), w.assert_final.to_string())
+        })
+        .collect();
+    Ok(keys)
+}
+
+/// The rule itself on precomputed keys (unit-testable without a client).
+pub fn check_keys(keys: &[GraphKey], status: &Value) -> Result<Verdict, String> {
+    if !bridge_active(status) {
+        return Ok(Verdict::Inactive);
+    }
+    if keys.is_empty() {
+        return Err("REFUSE: no operator peg-out graph for this peg-in".into());
+    }
+    let b = bo(status);
+    let ops = b["operators"].as_object().cloned().unwrap_or_default();
+    for (dep, x, k2, af) in keys {
+        let Some((acct, rec)) = ops
+            .iter()
+            .find(|(_, r)| r["btc_xonly_hex"].as_str().map(|s| s.eq_ignore_ascii_case(x)) == Some(true))
+        else {
+            return Err(format!("REFUSE: operator {x} not registered on the Falcon ledger"));
+        };
+        if rec["status"].as_str() != Some("Active") {
+            return Err(format!("REFUSE: operator {x} not active ({})", rec["status"]));
+        }
+        let Some(bind) = b["graphs"].get(format!("{dep}:{x}")) else {
+            return Err(format!("REFUSE: operator {x} has not bound its graph for deposit {dep} on the Falcon ledger"));
+        };
+        if bind["account"].as_str() != Some(acct.as_str()) {
+            return Err(format!("REFUSE: binding for {x} posted by {} not by registered account {acct}", bind["account"]));
+        }
+        let eq = |k: &str, want: &str| bind[k].as_str().map(|s| s.eq_ignore_ascii_case(want)) == Some(true);
+        if !eq("kick_off_2_txid", k2) || !eq("assert_final_txid", af) {
+            return Err(format!("REFUSE: on-ledger binding for {x} does not match the presigned graph (kick_off_2 {k2}, assert_final {af})"));
+        }
+    }
+    Ok(Verdict::Bound(keys.len()))
+}
+
+pub fn check_peg_in(data: &BitVMClientPublicData, peg_in_id: &str, status: &Value) -> Result<Verdict, String> {
+    check_keys(&graph_keys(data, peg_in_id)?, status)
+}
+
+/// Guarded peg-in confirm: refuses (nothing broadcast) unless the rule passes.
+/// `Inactive` broadcasts (pre-bridge behaviour unchanged).
+pub async fn broadcast_peg_in_confirm_checked(
+    client: &mut crate::client::client::BitVMClient,
+    peg_in_id: &str,
+    status: &Value,
+) -> Result<bitcoin::Txid, String> {
+    check_peg_in(client.data(), peg_in_id, status)?;
+    client.broadcast_peg_in_confirm(&peg_in_id.to_string()).await.map_err(|e| format!("{e:?}"))
+}
+
+/// `falcon-pl-ctl [--addr RPC] status` (read-only).
+pub fn status_from_ctl(ctl: &str, rpc: &str) -> Result<Value, String> {
+    let mut c = std::process::Command::new(ctl);
+    if !rpc.is_empty() {
+        c.args(["--addr", rpc]);
+    }
+    let out = c.arg("status").output().map_err(|e| format!("{ctl}: {e}"))?;
+    if !out.status.success() {
+        return Err(format!("{ctl} status: exit {:?}", out.status.code()));
+    }
+    serde_json::from_slice(&out.stdout).map_err(|e| format!("status json: {e}"))
+}
+
+pub fn status_from_file(p: &std::path::Path) -> Result<Value, String> {
+    serde_json::from_slice(&std::fs::read(p).map_err(|e| format!("{}: {e}", p.display()))?).map_err(|e| e.to_string())
+}
+
+/// Status JSON a test/operator would see once these graphs are bound by `accounts[i]`.
+pub fn bound_status_for(keys: &[GraphKey], accounts: &[&str]) -> Value {
+    let mut ops = serde_json::Map::new();
+    let mut graphs = serde_json::Map::new();
+    for (i, (dep, x, k2, af)) in keys.iter().enumerate() {
+        let a = accounts.get(i).copied().unwrap_or("op");
+        ops.insert(a.to_string(), serde_json::json!({"btc_xonly_hex": x, "status": "Active"}));
+        graphs.insert(format!("{dep}:{x}"), serde_json::json!({"account": a, "kick_off_2_txid": k2, "assert_final_txid": af}));
+    }
+    serde_json::json!({"body": {"bridge_operators": {"active": true, "operators": ops, "graphs": graphs}}})
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn keys() -> Vec<GraphKey> {
+        vec![("cd".repeat(32), "aa".repeat(32), "2b".repeat(32), "af".repeat(32))]
+    }
+    #[test]
+    fn rule() {
+        let k = keys();
+        let ok = bound_status_for(&k, &["op1"]);
+        assert_eq!(check_keys(&k, &ok), Ok(Verdict::Bound(1)));
+        assert_eq!(check_keys(&k, &serde_json::json!({"body": {"height": 3}})), Ok(Verdict::Inactive));
+        let mut s = ok.clone();
+        s["body"]["bridge_operators"]["graphs"] = serde_json::json!({});
+        assert!(check_keys(&k, &s).unwrap_err().contains("has not bound"));
+        let mut s = ok.clone();
+        s["body"]["bridge_operators"]["graphs"][format!("{}:{}", k[0].0, k[0].1)]["kick_off_2_txid"] = "00".repeat(32).into();
+        assert!(check_keys(&k, &s).unwrap_err().contains("does not match"));
+        let mut s = ok.clone();
+        s["body"]["bridge_operators"]["operators"]["op1"]["status"] = serde_json::json!({"Jailed": {"until_epoch": 3}});
+        assert!(check_keys(&k, &s).unwrap_err().contains("not active"));
+        assert!(check_keys(&[], &ok).is_err());
+    }
+}
diff --git a/bridge/src/fpl_ceremony.rs b/bridge/src/fpl_ceremony.rs
new file mode 100644
index 0000000..943a550
--- /dev/null
+++ b/bridge/src/fpl_ceremony.rs
@@ -0,0 +1,475 @@
+//! FPL patch: per-machine n-of-n presigning ceremony.
+//!
+//! Each participant runs `participant()` on its own machine. Its verifier key
+//! is generated in RAM, never serialised, never printed, and wiped right after
+//! the last partial signature. Secret MuSig2 nonces also stay in RAM (unlike
+//! upstream BitVMClient, which persists them to a private file).
+//!
+//! Participants and the coordinator exchange only public data through an
+//! exchange directory (rsync/sftp/shared volume between machines):
+//!   pub/<id>.json        participant pubkey
+//!   graphs.json          coordinator: unsigned graphs (BitVMClientPublicData) + n-of-n key list
+//!   nonces/<id>.json     participant: graphs carrying its public nonces
+//!   nonced.json          coordinator: merged nonces of all participants
+//!   sigs/<id>.json       participant: graphs carrying its partial signatures
+//!   attest/<id>.json     participant: signed deletion attestation
+//!   final.json           coordinator: fully presigned graphs
+//!
+//! The deletion attestation is a BIP340 signature by the verifier key over
+//! sha256("FPL-CEREMONY-DELETE-v1" || transcript), made immediately before the
+//! wipe. It proves the signer held the key at the end of the ceremony and
+//! commits to the transcript; it cannot prove the key was really deleted
+//! (that is the trust assumption of each honest machine).
+use std::{
+    collections::HashMap,
+    fs,
+    path::{Path, PathBuf},
+    thread::sleep,
+    time::{Duration, Instant},
+};
+
+use bitcoin::{
+    hashes::{sha256, Hash},
+    key::Keypair,
+    secp256k1::{rand::rngs::OsRng, Message, SecretKey, SECP256K1},
+    Network, PublicKey, Txid, XOnlyPublicKey,
+};
+use alloy::hex;
+use musig2::SecNonce;
+use serde::{Deserialize, Serialize};
+
+use crate::{
+    client::client::BitVMClientPublicData,
+    contexts::verifier::VerifierContext,
+    graphs::base::BaseGraph,
+};
+
+pub const ATTEST_DOMAIN: &[u8] = b"FPL-CEREMONY-DELETE-v1";
+
+#[derive(Serialize, Deserialize, Clone)]
+pub struct PubAnnouncement {
+    pub id: String,
+    pub public_key: PublicKey,
+}
+
+#[derive(Serialize, Deserialize, Clone)]
+pub struct GraphsFile {
+    pub network: Network,
+    pub n_of_n_public_keys: Vec<PublicKey>,
+    /// Partial signatures are chained in this order: each seat signs on top
+    /// of its predecessor's output so the last seat's MuSig2 aggregation
+    /// (upstream finalises when all n partials are present) completes.
+    pub signing_order: Vec<String>,
+    pub data: BitVMClientPublicData,
+}
+
+#[derive(Serialize, Deserialize, Clone, Debug)]
+pub struct DeletionAttestation {
+    pub id: String,
+    pub public_key: PublicKey,
+    pub transcript_sha256: String,
+    pub graph_ids: Vec<String>,
+    pub signature_hex: String,
+    pub wiped_at_unix: u64,
+}
+
+impl DeletionAttestation {
+    pub fn verify(&self) -> bool {
+        let Ok(sig_bytes) = hex::decode(&self.signature_hex) else { return false };
+        let Ok(sig) = bitcoin::secp256k1::schnorr::Signature::from_slice(&sig_bytes) else { return false };
+        let Ok(t) = hex::decode(&self.transcript_sha256) else { return false };
+        let msg = attest_msg(&t);
+        let xonly = XOnlyPublicKey::from(self.public_key.inner);
+        SECP256K1.verify_schnorr(&sig, &msg, &xonly).is_ok()
+    }
+}
+
+fn attest_msg(transcript_hash: &[u8]) -> Message {
+    let mut b = ATTEST_DOMAIN.to_vec();
+    b.extend_from_slice(transcript_hash);
+    Message::from_digest(sha256::Hash::hash(&b).to_byte_array())
+}
+
+pub fn sha256_file(p: &Path) -> Vec<u8> {
+    sha256::Hash::hash(&fs::read(p).expect("read")).to_byte_array().to_vec()
+}
+
+fn write_json<T: Serialize>(p: &Path, v: &T) {
+    fs::create_dir_all(p.parent().unwrap()).unwrap();
+    let tmp = p.with_extension("tmp");
+    fs::write(&tmp, serde_json::to_vec_pretty(v).unwrap()).unwrap();
+    fs::rename(tmp, p).unwrap();
+}
+
+fn read_json<T: for<'de> Deserialize<'de>>(p: &Path) -> T {
+    serde_json::from_slice(&fs::read(p).unwrap()).unwrap()
+}
+
+fn wait_for(p: &Path, timeout: Duration) -> Result<(), String> {
+    let t0 = Instant::now();
+    while !p.exists() {
+        if t0.elapsed() > timeout {
+            return Err(format!("timeout waiting for {}", p.display()));
+        }
+        sleep(Duration::from_millis(200));
+    }
+    Ok(())
+}
+
+fn graph_ids(d: &BitVMClientPublicData) -> Vec<String> {
+    let mut v: Vec<String> = d.peg_in_graphs.iter().map(|g| g.id().clone()).collect();
+    v.extend(d.peg_out_graphs.iter().map(|g| g.id().clone()));
+    v
+}
+
+/// Template identity of a graph set: the graph ids (derived by upstream from
+/// the tx templates) - a participant refuses to sign if they change between
+/// rounds.
+fn template_fingerprint(d: &BitVMClientPublicData) -> Vec<String> {
+    let mut v = graph_ids(d);
+    v.sort();
+    v
+}
+
+/// What a depositor's signer insists on before signing (per-deposit design).
+#[derive(Debug, Default)]
+pub struct DepositorPolicy {
+    /// the UTXO(s) the depositor funded the peg-in deposit from
+    pub funding_outpoints: Vec<bitcoin::OutPoint>,
+    /// watcher-published connector C script_pubkeys (hex); empty = skip
+    pub published_connector_c_spks: Vec<String>,
+    /// depositor's own wallet signs the peg-in deposit/refund/confirm itself
+    pub wallet: Option<DepositorWallet>,
+}
+
+/// The depositor's own funding wallet (its key; never leaves this process).
+pub struct DepositorWallet {
+    pub secret_hex: String,
+    pub network: bitcoin::Network,
+    pub deposit_input: crate::transactions::base::Input,
+    pub evm_address: String,
+    /// seat order defining the n-of-n (must equal the coordinator's signing order)
+    pub seats: Vec<String>,
+}
+impl std::fmt::Debug for DepositorWallet {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "DepositorWallet{{deposit: {:?}, seats: {:?}}}", self.deposit_input.outpoint, self.seats)
+    }
+}
+
+/// Depositor step 0: once every seat's ephemeral pubkey is known, build the
+/// peg-in graph and sign deposit + refund + confirm-leaf depositor sig with
+/// the depositor's own wallet key. Writes peg_in_signed.json (public data).
+fn depositor_sign_peg_in(dir: &Path, w: &DepositorWallet, timeout: Duration) -> Result<String, String> {
+    let mut n_of_n = vec![];
+    for s in &w.seats {
+        let p = dir.join("pub").join(format!("{s}.json"));
+        wait_for(&p, timeout)?;
+        let a: PubAnnouncement = read_json(&p);
+        n_of_n.push(a.public_key);
+    }
+    let ctx = crate::contexts::depositor::DepositorContext::new(w.network, &w.secret_hex, &n_of_n);
+    let g = crate::graphs::peg_in::PegInGraph::new(&ctx, crate::transactions::base::Input { outpoint: w.deposit_input.outpoint, amount: w.deposit_input.amount }, &w.evm_address);
+    drop(ctx);
+    let id = g.id().clone();
+    write_json(&dir.join("peg_in_signed.json"), &g);
+    Ok(id)
+}
+
+pub fn check_depositor_policy(d: &BitVMClientPublicData, p: &DepositorPolicy) -> Result<(), String> {
+    if d.peg_in_graphs.len() != 1 {
+        return Err(format!("expected exactly 1 peg-in graph, got {}", d.peg_in_graphs.len()));
+    }
+    let pi = &d.peg_in_graphs[0];
+    let prev = pi.fpl_deposit_prevouts();
+    for o in &p.funding_outpoints {
+        if !prev.contains(o) {
+            return Err(format!("peg-in deposit does not spend our funding outpoint {o}"));
+        }
+    }
+    for po in &d.peg_out_graphs {
+        if po.fpl_peg_in_graph_id() != pi.id() {
+            return Err("peg-out graph for a different deposit".into());
+        }
+        if !p.published_connector_c_spks.is_empty() {
+            let spk = hex::encode(po.fpl_connector_c_spk().as_bytes());
+            if !p.published_connector_c_spks.contains(&spk) {
+                return Err(format!("connector C {spk} not in watcher-published set"));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// RAM-only participant. Returns the deletion attestation.
+pub fn participant(dir: &Path, id: &str, timeout: Duration) -> Result<DeletionAttestation, String> {
+    participant_with_policy(dir, id, timeout, None)
+}
+
+pub fn participant_with_policy(
+    dir: &Path,
+    id: &str,
+    timeout: Duration,
+    policy: Option<&DepositorPolicy>,
+) -> Result<DeletionAttestation, String> {
+    // 1. key in RAM
+    let mut secret = SecretKey::new(&mut OsRng);
+    let mut keypair = Keypair::from_secret_key(SECP256K1, &secret);
+    let public_key = PublicKey::new(keypair.public_key());
+    write_json(&dir.join("pub").join(format!("{id}.json")), &PubAnnouncement { id: id.into(), public_key });
+
+    let our_peg_in = match policy.and_then(|p| p.wallet.as_ref()) {
+        Some(w) => Some(depositor_sign_peg_in(dir, w, timeout)?),
+        None => None,
+    };
+
+    // 2. unsigned graphs
+    let gpath = dir.join("graphs.json");
+    wait_for(&gpath, timeout)?;
+    let graphs: GraphsFile = read_json(&gpath);
+    if !graphs.n_of_n_public_keys.contains(&public_key) {
+        return Err("our key is not in the n-of-n set".into());
+    }
+    if let Some(p) = policy {
+        check_depositor_policy(&graphs.data, p)?;
+        if let Some(id) = &our_peg_in {
+            if graphs.data.peg_in_graphs[0].id() != id {
+                return Err("peg-in graph is not the one our wallet signed".into());
+            }
+        }
+    }
+    let fp0 = template_fingerprint(&graphs.data);
+    let mut secret_hex = hex::encode(secret.secret_bytes());
+    let mut ctx = VerifierContext::new(graphs.network, &secret_hex, &graphs.n_of_n_public_keys);
+    // SAFETY of hygiene: overwrite the hex copy immediately.
+    unsafe { secret_hex.as_bytes_mut().iter_mut().for_each(|b| *b = b'0') };
+    drop(secret_hex);
+
+    // 3. nonces
+    let mut mine = graphs.data.clone();
+    let mut sec_nonces: HashMap<String, HashMap<Txid, HashMap<usize, SecNonce>>> = HashMap::new();
+    for gid in graph_ids(&mine) {
+        let n = mine.graph_mut(&gid).push_verifier_nonces(&ctx);
+        sec_nonces.insert(gid, n);
+    }
+    write_json(&dir.join("nonces").join(format!("{id}.json")), &mine);
+
+    // 4. sign over the merged nonce set
+    let npath = dir.join("nonced.json");
+    wait_for(&npath, timeout)?;
+    let nonced0: BitVMClientPublicData = read_json(&npath);
+    if template_fingerprint(&nonced0) != fp0 {
+        return Err("graph templates changed between rounds; refusing to sign".into());
+    }
+    let pos = graphs.signing_order.iter().position(|x| x == id).ok_or("not in signing order")?;
+    let mut nonced: BitVMClientPublicData = if pos == 0 {
+        nonced0
+    } else {
+        let prev = dir.join("sigs").join(format!("{}.json", graphs.signing_order[pos - 1]));
+        wait_for(&prev, timeout)?;
+        read_json(&prev)
+    };
+    if template_fingerprint(&nonced) != fp0 {
+        return Err("graph templates changed between rounds; refusing to sign".into());
+    }
+    for gid in graph_ids(&nonced) {
+        nonced.graph_mut(&gid).verifier_sign(&ctx, &sec_nonces[&gid]);
+    }
+    write_json(&dir.join("sigs").join(format!("{id}.json")), &nonced);
+
+    // 5. attestation, then wipe
+    let transcript = sha256_file(&npath);
+    let sig = SECP256K1.sign_schnorr(&attest_msg(&transcript), &keypair);
+    let att = DeletionAttestation {
+        id: id.into(),
+        public_key,
+        transcript_sha256: hex::encode(&transcript),
+        graph_ids: fp0,
+        signature_hex: hex::encode(sig.as_ref()),
+        wiped_at_unix: std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_secs(),
+    };
+    sec_nonces.clear(); // SecNonce zeroizes on drop
+    drop(sec_nonces);
+    ctx.wipe_secret();
+    drop(ctx);
+    keypair.non_secure_erase();
+    secret.non_secure_erase();
+    write_json(&dir.join("attest").join(format!("{id}.json")), &att);
+    Ok(att)
+}
+
+/// Coordinator step 1: wait for `n` pubkeys (sorted by id).
+pub fn collect_pubkeys(dir: &Path, n: usize, timeout: Duration) -> Result<Vec<PubAnnouncement>, String> {
+    let t0 = Instant::now();
+    loop {
+        let mut v: Vec<PubAnnouncement> = fs::read_dir(dir.join("pub"))
+            .map(|rd| {
+                rd.filter_map(|e| e.ok())
+                    .filter(|e| e.path().extension().map(|x| x == "json").unwrap_or(false))
+                    .map(|e| read_json::<PubAnnouncement>(&e.path()))
+                    .collect()
+            })
+            .unwrap_or_default();
+        if v.len() >= n {
+            v.sort_by(|a, b| a.id.cmp(&b.id));
+            return Ok(v);
+        }
+        if t0.elapsed() > timeout {
+            return Err(format!("only {} of {} pubkeys", v.len(), n));
+        }
+        sleep(Duration::from_millis(200));
+    }
+}
+
+pub fn publish_graphs(dir: &Path, g: &GraphsFile) {
+    write_json(&dir.join("graphs.json"), g);
+}
+
+fn collect_round(dir: &Path, sub: &str, ids: &[String], timeout: Duration) -> Result<Vec<BitVMClientPublicData>, String> {
+    let mut out = vec![];
+    for id in ids {
+        let p: PathBuf = dir.join(sub).join(format!("{id}.json"));
+        wait_for(&p, timeout)?;
+        out.push(read_json(&p));
+    }
+    Ok(out)
+}
+
+fn merge_all(base: &BitVMClientPublicData, parts: Vec<BitVMClientPublicData>) -> BitVMClientPublicData {
+    let mut m = base.clone();
+    for p in parts {
+        for g in p.peg_in_graphs.iter() {
+            if let Some(x) = m.peg_in_graphs.iter_mut().find(|x| x.id() == g.id()) {
+                x.merge(g);
+            }
+        }
+        for g in p.peg_out_graphs.iter() {
+            if let Some(x) = m.peg_out_graphs.iter_mut().find(|x| x.id() == g.id()) {
+                x.merge(g);
+            }
+        }
+    }
+    m
+}
+
+/// Coordinator steps 2-3: merge nonces, publish, merge signatures, check
+/// attestations; writes final.json and returns the presigned graphs.
+pub fn coordinate(
+    dir: &Path,
+    ids: &[String],
+    timeout: Duration,
+) -> Result<(BitVMClientPublicData, Vec<DeletionAttestation>), String> {
+    let graphs: GraphsFile = read_json(&dir.join("graphs.json"));
+    let nonced = merge_all(&graphs.data, collect_round(dir, "nonces", ids, timeout)?);
+    for g in nonced.peg_out_graphs.iter() {
+        if !g.has_all_nonces(&graphs.n_of_n_public_keys) {
+            return Err(format!("missing nonces for {}", g.id()));
+        }
+    }
+    write_json(&dir.join("nonced.json"), &nonced);
+    let transcript = hex::encode(sha256_file(&dir.join("nonced.json")));
+    let mut sig_rounds = collect_round(dir, "sigs", &graphs.signing_order, timeout)?;
+    let signed = sig_rounds.pop().ok_or("no signatures")?;
+    for g in signed.peg_out_graphs.iter() {
+        if !g.has_all_signatures(&graphs.n_of_n_public_keys) {
+            return Err(format!("missing signatures for {}", g.id()));
+        }
+    }
+    let mut atts = vec![];
+    for id in ids {
+        let p = dir.join("attest").join(format!("{id}.json"));
+        wait_for(&p, timeout)?;
+        let a: DeletionAttestation = read_json(&p);
+        if !a.verify() || a.transcript_sha256 != transcript || !graphs.n_of_n_public_keys.contains(&a.public_key) {
+            return Err(format!("bad deletion attestation from {id}"));
+        }
+        atts.push(a);
+    }
+    write_json(&dir.join("final.json"), &signed);
+    Ok((signed, atts))
+}
+
+/// Browser-depositor mode step 1 (intake side, no secret): wait for the
+/// operator seats' ceremony pubkeys, build the unsigned peg-in graph from the
+/// depositor's PUBLIC key, write depositor_request.json (PSBTs + sighashes)
+/// and peg_in_unsigned.json. The n-of-n is exactly `seats` (operators only).
+pub fn external_depositor_prepare(
+    dir: &Path,
+    network: bitcoin::Network,
+    depositor_public_key: &PublicKey,
+    deposit_input: crate::transactions::base::Input,
+    evm_address: &str,
+    seats: &[String],
+    timeout: Duration,
+) -> Result<String, String> {
+    let mut n_of_n = vec![];
+    for s in seats {
+        let p = dir.join("pub").join(format!("{s}.json"));
+        wait_for(&p, timeout)?;
+        let a: PubAnnouncement = read_json(&p);
+        n_of_n.push(a.public_key);
+    }
+    let g = crate::graphs::peg_in::PegInGraph::fpl_new_external(network, depositor_public_key, &n_of_n, evm_address, deposit_input);
+    let reqs = g.fpl_depositor_requests()?;
+    let mut psbts = serde_json::Map::new();
+    let mut sighashes = serde_json::Map::new();
+    for (name, psbt, sh) in &reqs {
+        psbts.insert(name.clone(), serde_json::Value::String(psbt.clone()));
+        sighashes.insert(name.clone(), serde_json::Value::String(sh.clone()));
+    }
+    let confirm_txid = {
+        use crate::transactions::pre_signed::PreSignedTransaction;
+        g.peg_in_confirm_transaction_ref().tx().compute_txid().to_string()
+    };
+    let req = serde_json::json!({
+        "version": 1,
+        "graph_id": g.id(),
+        "network": network.to_string(),
+        "depositor_public_key": depositor_public_key.to_string(),
+        "deposit_txid": g.fpl_deposit_txid().to_string(),
+        "peg_in_confirm_txid": confirm_txid,
+        "n_of_n_seats": seats,
+        "psbts": psbts,
+        "sighashes": sighashes,
+        "note": "sign each PSBT input 0 with SIGHASH_ALL: deposit = P2WSH <pk> CHECKSIG (ECDSA); refund/confirm = tapscript leaf (BIP340)",
+    });
+    write_json(&dir.join("peg_in_unsigned.json"), &g);
+    write_json(&dir.join("depositor_request.json"), &req);
+    Ok(g.id().clone())
+}
+
+/// Browser-depositor mode step 2: take the signed PSBTs, check each is OUR
+/// unsigned tx, extract the depositor signature, verify it, write
+/// peg_in_signed.json (picked up by the coordinator like fpl_depositor's).
+pub fn external_depositor_finish(dir: &Path, signed: &serde_json::Value) -> Result<String, String> {
+    let g: crate::graphs::peg_in::PegInGraph = read_json(&dir.join("peg_in_unsigned.json"));
+    let reqs = g.fpl_depositor_requests()?;
+    let psbt = |name: &str| -> Result<bitcoin::Psbt, String> {
+        let h = signed[name].as_str().ok_or(format!("missing signed {name} PSBT"))?;
+        let b = hex::decode(h.trim()).map_err(|e| format!("{name}: {e}"))?;
+        let p = bitcoin::Psbt::deserialize(&b).map_err(|e| format!("{name}: {e}"))?;
+        let ours = reqs.iter().find(|r| r.0 == name).ok_or("unknown request")?;
+        let mine = bitcoin::Psbt::deserialize(&hex::decode(&ours.1).unwrap()).unwrap();
+        if p.unsigned_tx != mine.unsigned_tx {
+            return Err(format!("{name}: signed PSBT is not the prepared transaction"));
+        }
+        Ok(p)
+    };
+    let d = psbt("deposit")?;
+    let dep_sig = d.inputs[0]
+        .partial_sigs
+        .values()
+        .next()
+        .copied()
+        .ok_or("deposit: no ECDSA partial signature")?;
+    let tap = |name: &str| -> Result<bitcoin::taproot::Signature, String> {
+        let p = psbt(name)?;
+        p.inputs[0].tap_script_sigs.values().next().copied().ok_or(format!("{name}: no tapscript signature"))
+    };
+    let signed_g = g.fpl_with_depositor_signatures(dep_sig, tap("refund")?, tap("confirm")?)?;
+    write_json(&dir.join("peg_in_signed.json"), &signed_g);
+    Ok(signed_g.id().clone())
+}
diff --git a/bridge/src/fpl_watcher.rs b/bridge/src/fpl_watcher.rs
new file mode 100644
index 0000000..113bcc4
--- /dev/null
+++ b/bridge/src/fpl_watcher.rs
@@ -0,0 +1,264 @@
+//! FPL patch (M3): permissionless challenger / disprover watcher.
+//!
+//! Needs no n-of-n key and no operator key: anyone running it with a small
+//! hot wallet for the challenge crowdfunding input can stop a dishonest
+//! operator. Rewards go to a script of the watcher's choice.
+//!
+//! Disprove / disprove-chain txs carry BitVM chunk leaves of 3.6-3.8 MB and
+//! are therefore non-standard (> 400k WU). Decision 2026-10-18 (Scott):
+//! submit them DIRECT TO MINERS via a pluggable endpoint list, with our own
+//! testnet4 miner (bitcoind with acceptnonstdtxn=1 + block template miner)
+//! as the fallback. Standard txs (challenge) go via normal relay.
+use std::time::Duration;
+
+use bitcoin::{consensus::encode::serialize_hex, Transaction, Txid};
+use esplora_client::AsyncClient;
+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Copy, Debug)]
+pub struct WatchTxids {
+    pub kick_off_1: Txid,
+    pub kick_off_2: Txid,
+    pub challenge: Txid,
+    pub assert_final: Txid,
+    pub disprove: Txid,
+    pub disprove_chain: Txid,
+    pub take_1: Txid,
+    pub take_2: Txid,
+}
+
+/// One way of getting a raw tx into a block.
+#[derive(Serialize, Deserialize, Clone, Debug)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+pub enum SubmitChannel {
+    /// Standard P2P relay through an Esplora-compatible API (`POST /tx`).
+    Esplora { url: String },
+    /// Miner direct-submission HTTP endpoint. Body is the raw hex tx;
+    /// optional bearer token is read from the named env var (never stored).
+    MinerHttp {
+        name: String,
+        url: String,
+        #[serde(default)]
+        auth_env: Option<String>,
+        #[serde(default = "default_ct")]
+        content_type: String,
+    },
+    /// Bitcoin Core JSON-RPC of a node that mines (our own testnet4 miner,
+    /// started with acceptnonstdtxn=1). Credentials from env vars.
+    BitcoindRpc { name: String, url: String, user_env: String, pass_env: String },
+}
+fn default_ct() -> String {
+    "text/plain".into()
+}
+
+#[derive(Serialize, Deserialize, Clone, Debug, Default)]
+pub struct SubmitConfig {
+    /// Channels for standard txs, tried in order.
+    pub standard: Vec<SubmitChannel>,
+    /// Channels for non-standard (oversize) txs, tried in order: miner
+    /// endpoints first, own miner last.
+    pub nonstandard: Vec<SubmitChannel>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct SubmitAttempt {
+    pub channel: String,
+    pub ok: bool,
+    pub detail: String,
+}
+
+impl SubmitChannel {
+    pub fn label(&self) -> String {
+        match self {
+            SubmitChannel::Esplora { url } => format!("esplora:{url}"),
+            SubmitChannel::MinerHttp { name, .. } => format!("miner:{name}"),
+            SubmitChannel::BitcoindRpc { name, .. } => format!("rpc:{name}"),
+        }
+    }
+
+    pub async fn submit(&self, http: &reqwest::Client, tx: &Transaction) -> Result<String, String> {
+        let hex = serialize_hex(tx);
+        match self {
+            SubmitChannel::Esplora { url } => {
+                let r = http.post(format!("{}/tx", url.trim_end_matches('/'))).body(hex).send().await.map_err(|e| e.to_string())?;
+                let st = r.status();
+                let body = r.text().await.unwrap_or_default();
+                if st.is_success() { Ok(body) } else { Err(format!("{st}: {body}")) }
+            }
+            SubmitChannel::MinerHttp { url, auth_env, content_type, .. } => {
+                let mut req = http.post(url).header("Content-Type", content_type.as_str()).body(hex);
+                if let Some(env) = auth_env {
+                    if let Ok(tok) = std::env::var(env) {
+                        req = req.bearer_auth(tok);
+                    }
+                }
+                let r = req.send().await.map_err(|e| e.to_string())?;
+                let st = r.status();
+                let body = r.text().await.unwrap_or_default();
+                if st.is_success() { Ok(body) } else { Err(format!("{st}: {body}")) }
+            }
+            SubmitChannel::BitcoindRpc { url, user_env, pass_env, .. } => {
+                let user = std::env::var(user_env).map_err(|_| format!("{user_env} unset"))?;
+                let pass = std::env::var(pass_env).map_err(|_| format!("{pass_env} unset"))?;
+                let body = serde_json::json!({"jsonrpc":"1.0","id":"fpl","method":"sendrawtransaction","params":[hex, 0]});
+                let r = http.post(url).basic_auth(user, Some(pass)).header("Content-Type", "application/json").body(body.to_string()).send().await.map_err(|e| e.to_string())?;
+                let v: serde_json::Value = serde_json::from_str(&r.text().await.map_err(|e| e.to_string())?).map_err(|e| e.to_string())?;
+                if v["error"].is_null() { Ok(v["result"].to_string()) } else { Err(v["error"].to_string()) }
+            }
+        }
+    }
+}
+
+/// 400k WU standardness limit.
+pub fn is_standard_size(tx: &Transaction) -> bool {
+    tx.weight().to_wu() <= 400_000
+}
+
+/// Route a tx: standard-size txs try `standard` then `nonstandard`;
+/// oversize txs go only to `nonstandard`. Returns all attempts; success if
+/// any channel accepted.
+pub async fn submit(cfg: &SubmitConfig, tx: &Transaction) -> (bool, Vec<SubmitAttempt>) {
+    let http = reqwest::Client::builder().timeout(Duration::from_secs(30)).build().unwrap();
+    let mut chans: Vec<&SubmitChannel> = vec![];
+    if is_standard_size(tx) {
+        chans.extend(cfg.standard.iter());
+    }
+    chans.extend(cfg.nonstandard.iter());
+    let mut attempts = vec![];
+    for c in chans {
+        let r = c.submit(&http, tx).await;
+        let ok = r.is_ok();
+        attempts.push(SubmitAttempt { channel: c.label(), ok, detail: r.unwrap_or_else(|e| e) });
+        if ok {
+            return (true, attempts);
+        }
+    }
+    (false, attempts)
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum WatchAction {
+    Nothing,
+    /// Kick-off 1 confirmed for a peg-out we consider invalid: challenge.
+    Challenge,
+    /// Assert final confirmed: try to find a faulty chunk and disprove.
+    TryDisprove,
+    /// Kick-off 2 confirmed: try disprove-chain (superblock check).
+    TryDisproveChain,
+    /// Graph settled (take or disprove mined).
+    Done,
+}
+
+async fn confirmed(c: &AsyncClient, t: &Txid) -> bool {
+    c.get_tx_status(t).await.map(|s| s.confirmed).unwrap_or(false)
+}
+
+/// Decide what to do for one graph. `peg_out_valid_on_l2` is the watcher's
+/// own judgement (from FPL chain: was the withdrawal really burned?).
+pub async fn decide(
+    c: &AsyncClient,
+    t: &WatchTxids,
+    peg_out_valid_on_l2: bool,
+    tried_disprove: bool,
+) -> WatchAction {
+    if confirmed(c, &t.take_1).await
+        || confirmed(c, &t.take_2).await
+        || confirmed(c, &t.disprove).await
+        || confirmed(c, &t.disprove_chain).await
+    {
+        return WatchAction::Done;
+    }
+    if confirmed(c, &t.assert_final).await && !tried_disprove {
+        return WatchAction::TryDisprove;
+    }
+    if confirmed(c, &t.kick_off_1).await && !confirmed(c, &t.challenge).await && !peg_out_valid_on_l2 {
+        return WatchAction::Challenge;
+    }
+    if confirmed(c, &t.kick_off_2).await && !tried_disprove {
+        return WatchAction::TryDisproveChain;
+    }
+    WatchAction::Nothing
+}
+
+/// Watcher-side state for one graph.
+#[derive(Default, Debug, Clone, Serialize)]
+pub struct GraphWatchState {
+    pub tried_disprove: bool,
+    pub tried_disprove_chain: bool,
+    pub challenged: bool,
+    pub log: Vec<String>,
+}
+
+pub struct WatcherIdentity<'a> {
+    /// Small hot wallet funding the challenge crowdfunding input (not custody).
+    pub challenge_inputs: Vec<crate::transactions::base::InputWithScript<'a>>,
+    pub challenge_keypair: bitcoin::key::Keypair,
+    /// Where challenge/disprove rewards go.
+    pub reward_spk: bitcoin::ScriptBuf,
+}
+
+/// One watcher step for one graph. Returns the action taken.
+pub async fn step(
+    c: &AsyncClient,
+    graph: &mut crate::graphs::peg_out::PegOutGraph,
+    vk: &crate::common::ZkProofVerifyingKey,
+    cfg: &SubmitConfig,
+    who: &WatcherIdentity<'_>,
+    peg_out_valid_on_l2: bool,
+    st: &mut GraphWatchState,
+) -> WatchAction {
+    let t = graph.fpl_watch_txids();
+    let a = decide(c, &t, peg_out_valid_on_l2 || st.challenged, st.tried_disprove).await;
+    match a {
+        WatchAction::Challenge => {
+            match graph.challenge(c, &who.challenge_inputs, &who.challenge_keypair, who.reward_spk.clone()).await {
+                Ok(tx) => {
+                    let (ok, att) = submit(cfg, &tx).await;
+                    st.challenged = ok;
+                    st.log.push(format!("challenge {} ok={ok} {:?}", tx.compute_txid(), att));
+                }
+                Err(e) => st.log.push(format!("challenge build failed: {e:?}")),
+            }
+        }
+        WatchAction::TryDisprove => {
+            st.tried_disprove = true;
+            let built = match graph.disprove(c, who.reward_spk.clone(), vk).await {
+                Ok(tx) => Ok(tx),
+                Err(e) => {
+                    // proof verifies: check it is bound to THIS payout (SHA256 binding leaf)
+                    st.log.push(format!("chunk disprove n/a ({e:?}); trying binding leaf"));
+                    graph.fpl_binding_disprove(c, who.reward_spk.clone()).await
+                }
+            };
+            match built {
+                Ok(tx) => {
+                    let (ok, att) = submit(cfg, &tx).await;
+                    st.log.push(format!(
+                        "DISPROVE {} weight={} ok={ok} {:?}",
+                        tx.compute_txid(),
+                        tx.weight().to_wu(),
+                        att
+                    ));
+                    if !ok {
+                        st.tried_disprove = false; // retry next step
+                    }
+                }
+                Err(e) => st.log.push(format!("no disprove (assertions valid or not ready): {e:?}")),
+            }
+        }
+        WatchAction::TryDisproveChain => {
+            if !st.tried_disprove_chain {
+                st.tried_disprove_chain = true;
+                match graph.disprove_chain(c, who.reward_spk.clone()).await {
+                    Ok(tx) => {
+                        let (ok, att) = submit(cfg, &tx).await;
+                        st.log.push(format!("disprove_chain {} ok={ok} {:?}", tx.compute_txid(), att));
+                    }
+                    Err(e) => st.log.push(format!("no disprove_chain: {e:?}")),
+                }
+            }
+        }
+        _ => {}
+    }
+    a
+}
