+    }
+
+    pub fn fpl_deposit_prevouts(&self) -> Vec<bitcoin::OutPoint> {
+        use crate::transactions::pre_signed::PreSignedTransaction;
+        self.peg_in_deposit_transaction.tx().input.iter().map(|i| i.previous_output).collect()
+    }
