+/// FPL testnet4 timelocks (`fpl-tn4-timelocks`): graph timelocks scale with the mainnet
+/// values instead of collapsing to 2 blocks, so a Disprove has a real window. Exercised on
+/// regtest with FPL_REGTEST_TIMELOCK_DIVISOR=8 (2 weeks -> 252 blocks, same code path; the watcher
+/// needs ~150 regtest blocks (2 s each) to build the Disprove, so a 2-block window would lose):
+/// after a dishonest Assert Final the operator's Take 2 is refused for the whole window
+/// while the watcher's Disprove is mined inside it.
+#[tokio::test]
+#[serial]
+async fn test_fpl_disprove_window_scaled_timelocks() {
+    use bridge::constants::*;
+    use bridge::fpl_watcher::{self, GraphWatchState, SubmitChannel, SubmitConfig, WatchAction, WatcherIdentity};
+    use bridge::utils::num_blocks_per_network;
+    struct EnvGuard;
+    impl Drop for EnvGuard {
+        fn drop(&mut self) { std::env::remove_var("FPL_REGTEST_TIMELOCK_DIVISOR"); }
+    }
+    std::env::set_var("FPL_REGTEST_TIMELOCK_DIVISOR", "8");
+    let _g = EnvGuard;
+    let net = bitcoin::Network::Regtest;
+    let window = num_blocks_per_network(net, NUM_BLOCKS_PER_2_WEEKS);
+    assert_eq!(window, 252);
+    assert_eq!(num_blocks_per_network(net, NUM_BLOCKS_PER_2_WEEKS + NUM_BLOCKS_PER_DAY), 270);
+    assert_eq!(num_blocks_per_network(net, NUM_BLOCKS_PER_3_DAYS), 54);
+    println!("FPL scaled timelocks: take-2 window {window} blocks (testnet4 build: {} blocks)", bridge::utils::fpl_scaled_timelock(NUM_BLOCKS_PER_2_WEEKS, bridge::utils::FPL_TN4_TIMELOCK_DIVISOR));
+
+    macro_rules! until_ok {
+        ($e:expr, $what:expr) => {{
+            let mut tries = 0;
+            loop {
+                match $e {
+                    Ok(v) => break v,
+                    Err(err) => {
+                        tries += 1;
+                        assert!(tries < 900, "{}: {:?}", $what, err);
+                        tokio::time::sleep(std::time::Duration::from_secs(2)).await;
+                    }
+                }
+            }
+        }};
+    }
+    let (mut c, peg_in_graph_id, peg_out_graph_id) = fpl_ceremony_setup().await;
+    c.client.broadcast_peg_in_confirm(&peg_in_graph_id).await.expect("peg-in confirm");
+    wait_for_confirmation_with_message(c.client.source_network, Some("peg-in confirm")).await;
+    simulate_peg_out_from_l2(&mut c.client, &peg_out_graph_id, &c.operator_context, &c.withdrawer_evm_address.clone(), &c.withdrawer_context).await;
+
+    let wk = bitcoin::key::Keypair::new(bitcoin::secp256k1::SECP256K1, &mut bitcoin::secp256k1::rand::thread_rng());
+    let wpub = bitcoin::PublicKey::new(wk.public_key());
+    let w_addr = generate_pay_to_pubkey_script_address(c.client.source_network, &wpub);
+    let w_amt = Amount::from_btc(1.0).unwrap();
+    Faucet::new(FaucetType::EsploraRegtest).fund_input(&w_addr, w_amt).await.wait().await;
+    let w_out = generate_stub_outpoint(&c.client, &w_addr, w_amt).await;
+    let w_script = generate_pay_to_pubkey_script(&wpub);
+    let who = WatcherIdentity { challenge_inputs: vec![InputWithScript { outpoint: w_out, amount: w_amt, script: &w_script }], challenge_keypair: wk, reward_spk: w_script.clone() };
+    let cfg = SubmitConfig {
+        standard: vec![SubmitChannel::Esplora { url: "http://127.0.0.1:8094/regtest/api".into() }],
+        nonstandard: vec![SubmitChannel::BitcoindRpc { name: "own-miner".into(), url: "http://127.0.0.1:18543".into(), user_env: "FPL_MINER_RPC_USER".into(), pass_env: "FPL_MINER_RPC_PASS".into() }],
+    };
+    let vk = crate::bridge::helper::get_valid_proof().vk;
+    let mut wgraph = c.client.data().peg_out_graphs.iter().find(|g| bridge::graphs::base::BaseGraph::id(*g) == &peg_out_graph_id).unwrap().clone();
+    let mut st = GraphWatchState::default();
+
+    c.client.broadcast_kick_off_1(&peg_out_graph_id).await.expect("kick-off 1");
+    wait_for_confirmation_with_message(c.client.source_network, Some("kick-off 1")).await;
+    assert_eq!(fpl_watcher::step(&c.client.esplora, &mut wgraph, &vk, &cfg, &who, false, &mut st).await, WatchAction::Challenge);
+    wait_for_confirmation_with_message(c.client.source_network, Some("challenge")).await;
+    until_ok!(c.client.broadcast_start_time(&peg_out_graph_id).await, "start time");
+    wait_for_confirmation_with_message(c.client.source_network, Some("start time")).await;
+    until_ok!(c.client.broadcast_kick_off_2(&peg_out_graph_id).await, "kick-off 2 (2-week leaf, scaled)");
+    wait_for_confirmation_with_message(c.client.source_network, Some("kick-off 2")).await;
+    let invalid = crate::bridge::helper::invalidate_proof(&crate::bridge::helper::get_valid_proof());
+    until_ok!(c.client.broadcast_assert_initial(&peg_out_graph_id).await, "assert initial");
+    wait_for_confirmation_with_message(c.client.source_network, Some("assert initial")).await;
+    c.client.broadcast_assert_commits(&peg_out_graph_id, &invalid).await.expect("assert commits");
+    wait_for_confirmation_with_message(c.client.source_network, Some("assert commits")).await;
+    wait_for_confirmation_with_message(c.client.source_network, Some("assert commits")).await;
+    until_ok!(c.client.broadcast_assert_final(&peg_out_graph_id).await, "assert final");
+    wait_for_confirmation_with_message(c.client.source_network, Some("assert final")).await;
+    let t = wgraph.fpl_watch_txids();
+    let af_h = c.client.esplora.get_tx_status(&t.assert_final).await.unwrap().block_height.expect("assert final mined");
+
+    // inside the window: Take 2 is refused (not BIP68-final) even after 2 blocks (the upstream window)
+    let tip = |c: &BitVMClient| { let e = c.esplora.clone(); async move { e.get_height().await.unwrap() } };
+    while tip(&c.client).await < af_h + 2 {
+        tokio::time::sleep(std::time::Duration::from_secs(1)).await;
+    }
+    let early = c.client.broadcast_take_2(&peg_out_graph_id).await;
+    println!("take 2 at +{} blocks: {:?}", tip(&c.client).await - af_h, early.as_ref().map(|_| "accepted"));
+    assert!(early.is_err(), "Take 2 must be refused inside the scaled window");
+
+    // the watcher disproves inside the window
+    let mut disproved = false;
+    for i in 0..10 {
+        let a = fpl_watcher::step(&c.client.esplora, &mut wgraph, &vk, &cfg, &who, false, &mut st).await;
+        println!("watcher step {i}: {a:?}");
+        if a == WatchAction::Done { disproved = true; break; }
+        wait_for_confirmation_with_message(c.client.source_network, Some("watcher")).await;
+    }
+    for l in &st.log { println!("watcher log: {}", &l[..l.len().min(300)]); }
+    assert!(disproved, "disprove not mined");
+    // the broadcast Disprove carries the watcher's reward output, so take its txid from the watcher log
+    let d_txid: bitcoin::Txid = st.log.iter().find_map(|l| l.strip_prefix("DISPROVE ").and_then(|r| r.split_whitespace().next()).and_then(|x| x.parse().ok())).expect("DISPROVE txid in watcher log");
+    let mut d_h = None;
+    for _ in 0..60 {
+        d_h = c.client.esplora.get_tx_status(&d_txid).await.unwrap().block_height;
+        if d_h.is_some() { break; }
+        tokio::time::sleep(std::time::Duration::from_secs(1)).await;
+    }
+    let d_h = d_h.expect("disprove confirmed");
+    println!("disprove mined at +{} blocks after assert final (window {window})", d_h - af_h);
+    assert!(d_h - af_h < window, "disprove must land inside the window");
+    assert!(!c.client.esplora.get_tx_status(&t.take_2).await.unwrap().confirmed);
+    let late = c.client.broadcast_take_2(&peg_out_graph_id).await;
+    assert!(late.is_err(), "Take 2 must be impossible once the Disprove spent its inputs");
+    println!("take 2 after disprove: {:?}", late.map(|_| "accepted"));
+    println!("FPL scaled timelocks: Take 2 refused inside the window, Disprove mined at +{} of {window} PASS", d_h - af_h);
+}
