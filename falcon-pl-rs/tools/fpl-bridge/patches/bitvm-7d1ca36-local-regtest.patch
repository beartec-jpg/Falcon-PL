+//! Falcon PL chain adaptor (replaces the mock withdrawal event).
+//!
+//! Reads BTC withdrawal claims taken from the Falcon ledger
+//! (`rails[asset=BTC].bitvm2_claims`, status AwaitingPegout) by fpl-operatord and
+//! bound to one presigned deposit graph (claim -> peg-in confirm outpoint). The
+//! file is JSON: a list of `FalconClaim`. No keys involved; this is public data.
+use std::str::FromStr;
+
+use async_trait::async_trait;
+use bitcoin::{hashes::Hash, Address, Amount, Network, OutPoint, PubkeyHash, PublicKey};
+use serde::{Deserialize, Serialize};
+
+use super::{
+    chain::{PegInEvent, PegOutBurntEvent, PegOutEvent},
+    chain_adaptor::ChainAdaptor,
+};
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct FalconClaim {
+    /// Falcon withdrawal note id (also inscribed in the peg-out output, binding it).
+    pub note_id: String,
+    /// Destination BTC address from the ledger (P2PKH or P2WPKH: 20-byte hash).
+    pub dest: String,
+    pub amount: u64,
+    pub open_height: u64,
+    /// Peg-in confirm outpoint of the deposit graph bound to this claim ("txid:vout").
+    pub deposit_confirm_outpoint: String,
+    /// Operator compressed pubkey (hex) whose peg-out graph serves the claim.
+    pub operator_pubkey: String,
+}
+
+pub fn dest_pubkey_hash(dest: &str, network: Network) -> Result<PubkeyHash, String> {
+    let a = Address::from_str(dest).map_err(|e| format!("dest: {e}"))?
+        .require_network(network).map_err(|e| format!("dest network: {e}"))?;
+    let spk = a.script_pubkey();
+    let b = spk.as_bytes();
+    let h: &[u8] = if spk.is_p2pkh() { &b[3..23] } else if spk.is_p2wpkh() { &b[2..22] } else {
+        return Err("dest must be P2PKH or P2WPKH (20-byte hash)".into());
+    };
+    Ok(PubkeyHash::from_slice(h).map_err(|e| e.to_string())?)
+}
+
+pub fn claim_to_event(c: &FalconClaim, network: Network) -> Result<PegOutEvent, String> {
+    Ok(PegOutEvent {
+        source_outpoint: OutPoint::from_str(&c.deposit_confirm_outpoint).map_err(|e| e.to_string())?,
+        amount: Amount::from_sat(c.amount),
+        timestamp: c.open_height as u32,
+        withdrawer_chain_address: c.note_id.clone(),
+        withdrawer_destination_address: c.dest.clone(),
+        withdrawer_public_key_hash: dest_pubkey_hash(&c.dest, network)?,
+        operator_public_key: PublicKey::from_str(&c.operator_pubkey).map_err(|e| e.to_string())?,
+        tx_hash: [0u8; 4].into(),
+    })
+}
+
+pub struct FalconAdaptor {
+    pub claims_file: std::path::PathBuf,
+    pub network: Network,
+}
+
+#[async_trait]
+impl ChainAdaptor for FalconAdaptor {
+    async fn get_peg_out_init_event(&self) -> Result<Vec<PegOutEvent>, String> {
+        let s = std::fs::read_to_string(&self.claims_file).map_err(|e| e.to_string())?;
+        let v: Vec<FalconClaim> = serde_json::from_str(&s).map_err(|e| e.to_string())?;
+        v.iter().map(|c| claim_to_event(c, self.network)).collect()
+    }
+    async fn get_peg_out_burnt_event(&self) -> Result<Vec<PegOutBurntEvent>, String> {
+        Ok(vec![])
+    }
+    async fn get_peg_in_minted_event(&self) -> Result<Vec<PegInEvent>, String> {
+        Ok(vec![])
+    }
+}
