+/// FPL operator kit: a cheating kickoff (operator kicks off a peg-out whose withdrawal the
+/// watcher does not find in the Falcon ledger) is challenged ON-CHAIN by the `fpl_challenge`
+/// binary that fpl-operatord calls, funded from the watcher operator's own bitcoind wallet.
+/// Checks dry-run (nothing broadcast), live (Challenge mined, connector A spent by it) and
+/// idempotence (second run: ALREADY_CHALLENGED, no second funding).
+/// Needs FPL_BTC_DATADIR (regtest bitcoind with wallet "miner") and FPL_CHALLENGE_BIN
+/// (default: target/{release,debug}/examples/fpl_challenge).
+#[tokio::test]
+#[serial]
+async fn test_fpl_challenge_bin_challenges_cheating_kickoff() {
+    use bridge::graphs::base::BaseGraph;
+    let (mut c, peg_in_graph_id, peg_out_graph_id) = fpl_ceremony_setup().await;
+    c.client.broadcast_peg_in_confirm(&peg_in_graph_id).await.expect("peg-in confirm");
+    wait_for_confirmation_with_message(c.client.source_network, Some("peg-in confirm")).await;
+    simulate_peg_out_from_l2(&mut c.client, &peg_out_graph_id, &c.operator_context, &c.withdrawer_evm_address.clone(), &c.withdrawer_context).await;
+    c.client.broadcast_kick_off_1(&peg_out_graph_id).await.expect("kick-off 1");
+    wait_for_confirmation_with_message(c.client.source_network, Some("kick-off 1")).await;
+
+    // the watcher operator's kit home: presigned deposit graph as distributed (final.json)
+    let home = std::env::temp_dir().join(format!("fpl_challenge_home_{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&home);
+    std::fs::create_dir_all(home.join("graphs/dep1")).unwrap();
+    std::fs::write(home.join("graphs/dep1/final.json"), serde_json::to_vec(c.client.data()).unwrap()).unwrap();
+    let g = c.client.data().peg_out_graphs.iter().find(|g| g.id() == &peg_out_graph_id).unwrap().clone();
+    let operator_x = g.fpl_operator_public_key().inner.x_only_public_key().0.to_string();
+    let pi = c.client.data().peg_in_graphs.iter().find(|g| g.id() == &peg_in_graph_id).unwrap();
+    let confirm = {
+        use bridge::transactions::pre_signed::PreSignedTransaction;
+        format!("{}:0", pi.peg_in_confirm_transaction_ref().tx().compute_txid())
+    };
+    let conn_a = g.fpl_challenge_prevout();
+    let datadir = std::env::var("FPL_BTC_DATADIR").expect("FPL_BTC_DATADIR");
+    let bin = std::env::var("FPL_CHALLENGE_BIN").unwrap_or_else(|_| {
+        let t = std::env::var("CARGO_TARGET_DIR").unwrap_or(format!("{}/../target", env!("CARGO_MANIFEST_DIR")));
+        ["release", "debug"].iter().map(|p| format!("{t}/{p}/examples/fpl_challenge")).find(|p| std::path::Path::new(p).exists()).expect("build --example fpl_challenge")
+    });
+    // watcher's own key (random, test only; never printed)
+    let secret = bitcoin::secp256k1::SecretKey::new(&mut bitcoin::secp256k1::rand::thread_rng()).display_secret().to_string();
+    let run = |dry: bool| {
+        let o = std::process::Command::new(&bin)
+            .args(["--network", "regtest", "--deposit", &confirm, "--operator", &operator_x, "--esplora", "http://127.0.0.1:8094/regtest/api",
+                   "--bitcoin-cli", &format!("bitcoin-cli -datadir={datadir} -rpcwallet=miner")])
+            .env("FPL_OP_HOME", &home).env("FPL_OPERATOR_SECRET", &secret).env("FPL_DRY_RUN", if dry { "1" } else { "0" })
+            .output().expect("run fpl_challenge");
+        let out = String::from_utf8_lossy(&o.stdout).to_string();
+        println!("fpl_challenge dry={dry} exit={:?}\n{out}{}", o.status.code(), String::from_utf8_lossy(&o.stderr));
+        (o.status.code().unwrap_or(-1), out)
+    };
+    // connector A spent? (own bitcoind: gettxout null once spent)
+    let cli = |args: &[&str]| {
+        let o = std::process::Command::new("bitcoin-cli").arg(format!("-datadir={datadir}")).args(args).output().unwrap();
+        String::from_utf8_lossy(&o.stdout).trim().to_string()
+    };
+    let conn_a_unspent = || !cli(&["gettxout", &conn_a.txid.to_string(), &conn_a.vout.to_string()]).is_empty();
+
+    let (code, out) = run(true);
+    assert_eq!(code, 0);
+    assert!(out.contains("DRY_RUN"), "dry-run must only plan");
+    assert!(out.contains(&format!("fund {} sats", bridge::graphs::base::FPL_CROWDFUNDING_SATS_REGTEST)), "regtest crowdfunding = per-network amount");
+    assert!(conn_a_unspent(), "dry-run must not broadcast");
+
+    let (code, out) = run(false);
+    assert_eq!(code, 0, "challenge failed");
+    let txid = out.lines().find_map(|l| l.strip_prefix("CHALLENGE_TXID ")).expect("CHALLENGE_TXID").trim().to_string();
+    wait_for_confirmation_with_message(c.client.source_network, Some("challenge")).await;
+    let st = c.client.esplora.get_tx_status(&txid.parse().unwrap()).await.unwrap();
+    assert!(st.confirmed, "challenge not mined");
+    assert!(!conn_a_unspent(), "connector A must be spent");
+    let ch: serde_json::Value = serde_json::from_str(&cli(&["getrawtransaction", &txid, "true"])).unwrap();
+    assert!(ch["vin"].as_array().unwrap().iter().any(|i| i["txid"].as_str() == Some(&conn_a.txid.to_string()) && i["vout"].as_u64() == Some(conn_a.vout as u64)), "our Challenge spends connector A");
+
+    let (code, out) = run(false);
+    assert_eq!(code, 0);
+    assert!(out.contains(&format!("ALREADY_CHALLENGED {txid}")), "second run must not challenge again");
+    let state: serde_json::Value = serde_json::from_slice(&std::fs::read(home.join("state/fpl_challenge.json")).unwrap()).unwrap();
+    let e = &state[&peg_out_graph_id];
+    assert_eq!(e["challenge_txid"].as_str(), Some(txid.as_str()));
+    assert_eq!(e["log"].as_array().unwrap().iter().filter(|l| l.as_str().unwrap_or("").starts_with("funded ")).count(), 1, "funded once");
+    println!("FPL fpl_challenge: cheating kickoff challenged on-chain ({txid}), idempotent PASS");
+}
