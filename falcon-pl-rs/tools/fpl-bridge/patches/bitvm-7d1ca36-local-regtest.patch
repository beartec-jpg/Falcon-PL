+pub fn fpl_load_proof(dir: &std::path::Path) -> RawProof {
+    use ark_serialize::CanonicalDeserialize;
+    let vkb = std::fs::read(dir.join("vk.bin")).expect("vk.bin");
+    let mut r = &vkb[..];
+    let alpha_g1 = CanonicalDeserialize::deserialize_compressed(&mut r).unwrap();
+    let beta_g2 = CanonicalDeserialize::deserialize_compressed(&mut r).unwrap();
+    let gamma_g2 = CanonicalDeserialize::deserialize_compressed(&mut r).unwrap();
+    let delta_g2 = CanonicalDeserialize::deserialize_compressed(&mut r).unwrap();
+    let gamma_abc_g1: Vec<G1Affine> = CanonicalDeserialize::deserialize_compressed(&mut r).unwrap();
+    let vk = ark_groth16::VerifyingKey::<Bn254> { alpha_g1, beta_g2, gamma_g2, delta_g2, gamma_abc_g1 };
+    let pb = std::fs::read(dir.join("proof.bin")).expect("proof.bin");
+    let mut r = &pb[..];
+    let proof = ark_groth16::Proof::<Bn254> {
+        a: CanonicalDeserialize::deserialize_compressed(&mut r).unwrap(),
+        b: CanonicalDeserialize::deserialize_compressed(&mut r).unwrap(),
+        c: CanonicalDeserialize::deserialize_compressed(&mut r).unwrap(),
+    };
+    let xb = std::fs::read(dir.join("public.bin")).expect("public.bin");
+    let x: ark_bn254::Fr = CanonicalDeserialize::deserialize_compressed(&mut &xb[..]).unwrap();
+    assert!(Groth16::<Bn254>::verify(&vk, &[x], &proof).unwrap(), "FPL proof must verify");
+    RawProof { proof, public: vec![x], vk }
+}
