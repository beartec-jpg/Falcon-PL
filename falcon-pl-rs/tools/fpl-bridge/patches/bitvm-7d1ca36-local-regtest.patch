+/// FPL V3 binding: operator proves for `pegout_txid` with the V3 circuit
+/// (SHA256-bound public input) by calling the exporter binary.
+fn fpl_v3_prove(pegout_txid_internal: &[u8; 32], out: &std::path::Path) -> (bitvm::chunk::api::type_conversion_utils::RawProof, [u8; 32]) {
+    let bin = std::env::var("FPL_V3_PROVER").unwrap_or("/workspace/Falcon-PL/falcon-pl-rs/target/release/falcon-pl-bitvm2-v3-proof".into());
+    let st = std::process::Command::new(bin)
+        .args(["--out", out.to_str().unwrap(), "--amount", "50000", "--dest-h160", &"11".repeat(20),
+               "--pegout-txid", &alloy::hex::encode(pegout_txid_internal), "--height", "614000", "--header-hex", &"cd".repeat(32)])
+        .status().expect("run v3 prover");
+    assert!(st.success());
+    let b: [u8; 32] = alloy::hex::decode(std::fs::read_to_string(out.join("binding_commit.hex")).unwrap().trim()).unwrap().try_into().unwrap();
+    (bridge::proof::fpl_load_proof(out), b)
+}
