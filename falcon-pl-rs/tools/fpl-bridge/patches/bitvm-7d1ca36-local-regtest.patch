 const NUM_BLOCKS_REGTEST: u32 = 2;
 const NUM_BLOCKS_TESTNET: u32 = 2;
 
+/// FPL: with feature `fpl-tn4-timelocks`, testnet4 graph timelocks are the mainnet values
+/// divided by this (ceil, min 2), so their order is kept and a Disprove has a real window:
+/// 2 weeks (Take 2 / connector 4, connector 1 leaf 0, connector Z) -> 72 blocks (~24 h at
+/// testnet4's 20-minute min-difficulty pace), 3 days -> 16, 6 hours -> 2, 2 weeks + 1 day -> 78.
+/// Upstream (feature off) collapses every testnet timelock to 2 blocks (~40 min).
+/// Every party of a graph (depositor, operators, watchers) must build with the same setting.
+pub const FPL_TN4_TIMELOCK_DIVISOR: u32 = 28;
+
+/// Mainnet timelock scaled down by `divisor` (ceil), never below 2 blocks.
+pub fn fpl_scaled_timelock(mainnet_num_blocks: u32, divisor: u32) -> u32 {
+    mainnet_num_blocks.div_ceil(divisor.max(1)).max(2)
+}
+
+/// Regtest and (private) signet test runs: `FPL_REGTEST_TIMELOCK_DIVISOR=<d>` scales the
+/// timelocks the same way, so real windows can be exercised. Unset = upstream 2 blocks.
+fn fpl_regtest_divisor() -> Option<u32> {
+    std::env::var("FPL_REGTEST_TIMELOCK_DIVISOR").ok().and_then(|v| v.parse().ok()).filter(|d| *d > 0)
+}
+
