+fn strip(tx: &Transaction) -> Transaction {
+    let mut t = tx.clone();
+    for i in t.input.iter_mut() {
+        i.witness = bitcoin::Witness::new();
+        i.script_sig = bitcoin::ScriptBuf::new();
+    }
+    t
+}
