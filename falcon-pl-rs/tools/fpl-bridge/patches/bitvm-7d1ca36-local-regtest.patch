diff --git a/bridge/examples/fpl_ceremony_coordinator.rs b/bridge/examples/fpl_ceremony_coordinator.rs
new file mode 100644
index 0000000..d8d5627
--- /dev/null
+++ b/bridge/examples/fpl_ceremony_coordinator.rs
@@ -0,0 +1,500 @@
+//! Standalone ceremony coordinator (holds NO verifier key).
+//!
+//! Builds the peg-in + peg-out graphs for one deposit using the n-of-n keys
+//! announced by the seats, runs the nonce/signature rounds through the
+//! exchange directory, verifies the deletion attestations and writes
+//! final.json + transcript.json. Optional: broadcast the peg-in deposit /
+//! confirm.
+//!
+//!   fpl_ceremony_coordinator --dir D --seats seat-a,seat-b,seat-c \
+//!     --network regtest|testnet4 --esplora URL \
+//!     --deposit-outpoint TXID:VOUT --deposit-amount SATS \
+//!     --kickoff-outpoint TXID:VOUT --kickoff-amount SATS \
+//!     --evm-address ADDR [--broadcast] [--timeout-secs N]
+//!     [--falcon-ctl falcon-pl-ctl [--falcon-rpc URL] | --bindings-status FILE | --no-binding-check]
+//! BRIDGE refusal rule (fpl_bindings): with --broadcast, the peg-in deposit and confirm
+//! are only broadcast if every operator graph is bound on the Falcon ledger and matches
+//! (enforced once the ledger reports bridge_operators.active). On testnet4 a status
+//! source is required unless --no-binding-check is given explicitly.
+//! Resume (no seats, no re-signing): --resume [--resume-check] [--scenario take1|timeouts|disprove]
+//!   rebuilds the client from exchange/final.json + transcript.json and the operator's
+//!   saved private data (bridge_data/.../private, same cwd), verifies the WOTS secrets
+//!   reproduce the graph's commitment keys, then continues after KICK_OFF_1. With
+//!   --payout-outpoint TXID:VOUT it instead continues from PEG_OUT (payout already funded;
+//!   pass the original --event-timestamp so a PEG_OUT already on chain is the same tx).
+//! Scenario disprove (dishonest operator, testnet4 runbook f): KICK_OFF_1 for a withdrawal the
+//!   ledger never made; prints CHALLENGE_NEEDED <peg-in confirm txid:0> <operator x-only> and waits
+//!   for <dir>/challenge.txt (txid of the watcher's Challenge, e.g. fpl_challenge); then
+//!   START_TIME, KICK_OFF_2, ASSERT_INITIAL, ASSERT_COMMITS with a corrupted Groth16 proof
+//!   (FPL_PROOF_DIR proof with A negated), ASSERT_FINAL; prints ASSERTED_INVALID and waits for
+//!   <dir>/disprove.txt (watcher's DISPROVE_TXID), then checks TAKE_1 and TAKE_2 both fail.
+//! Per-deposit only (design 2026-10-18): seats default to
+//! depositor-wallet,fpl-signer; both are ephemeral RAM-only keys.
+//! The depositor's wallet signs the peg-in itself (fpl_depositor writes
+//! peg_in_signed.json); the coordinator holds no depositor key. Operator funding
+//! secret from env FPL_OPERATOR_SECRET (operator keys are not custody: the operator can only
+//! claim reimbursement through Take1/Take2 under the presigned graph).
+use std::{str::FromStr, time::Duration};
+
+use bitcoin::{Amount, Network, OutPoint};
+use bridge::{
+    client::{chain::chain_adaptor::get_chain_adaptor, client::BitVMClient},
+    commitments::CommitmentMessageId,
+    fpl_ceremony,
+    graphs::base::BaseGraph,
+    transactions::base::Input,
+};
+
+fn arg(a: &[String], k: &str) -> Option<String> {
+    a.iter().position(|x| x == k).map(|i| a[i + 1].clone())
+}
+
+#[tokio::main]
+async fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let req = |k: &str| arg(&a, k).unwrap_or_else(|| panic!("missing {k}"));
+    let dir = std::path::PathBuf::from(req("--dir"));
+    let seats: Vec<String> = arg(&a, "--seats").unwrap_or("depositor-wallet,fpl-signer".into()).split(',').map(|s| s.to_string()).collect();
+    let network = match req("--network").as_str() {
+        "regtest" => Network::Regtest,
+        "testnet4" => Network::Testnet4,
+        "signet" => Network::Signet,
+        n => panic!("unsupported network {n}"),
+    };
+    let esplora = req("--esplora");
+    if a.iter().any(|x| x == "--print-funding-addresses") {
+        let (_, opk) = bridge::contexts::base::generate_keys_from_secret(network, &std::env::var("FPL_OPERATOR_SECRET").unwrap());
+        println!("operator {}", bridge::scripts::generate_pay_to_pubkey_script_address(network, &opk));
+        println!("peg_in_fee {}", bridge::graphs::base::PEG_IN_FEE);
+        println!("peg_out_fee {}", bridge::graphs::base::PEG_OUT_FEE);
+        return;
+    }
+
+    if a.iter().any(|x| x == "--resume") {
+        resume(&a, &dir, network, &esplora, &std::env::var("FPL_OPERATOR_SECRET").expect("FPL_OPERATOR_SECRET")).await;
+        return;
+    }
+    let timeout = Duration::from_secs(arg(&a, "--timeout-secs").map(|s| s.parse().unwrap()).unwrap_or(3600));
+    struct QueueEntry { deposit_outpoint: String, deposit_amount: u64, evm_address: String, kickoff_outpoint: String, kickoff_amount: u64 }
+    assert!(arg(&a, "--batch").is_none(), "--batch removed: one deposit per signing session");
+    let queue: Vec<QueueEntry> = vec![QueueEntry {
+        deposit_outpoint: req("--deposit-outpoint"),
+        deposit_amount: req("--deposit-amount").parse().unwrap(),
+        evm_address: req("--evm-address"),
+        kickoff_outpoint: req("--kickoff-outpoint"),
+        kickoff_amount: req("--kickoff-amount").parse().unwrap(),
+    }];
+    let osec = std::env::var("FPL_OPERATOR_SECRET").expect("FPL_OPERATOR_SECRET");
+
+    std::fs::create_dir_all(&dir).unwrap();
+    println!("waiting for {} seat pubkeys in {}", seats.len(), dir.display());
+    let pubs = fpl_ceremony::collect_pubkeys(&dir, seats.len(), timeout).unwrap();
+    let pubs: Vec<_> = seats
+        .iter()
+        .map(|s| pubs.iter().find(|p| &p.id == s).unwrap_or_else(|| panic!("no pubkey from {s}")).clone())
+        .collect();
+    let n_of_n: Vec<bitcoin::PublicKey> = pubs.iter().map(|p| p.public_key).collect();
+    for p in &pubs {
+        println!("seat {} pubkey {}", p.id, p.public_key);
+    }
+
+    let mut client = BitVMClient::new(
+        Some(&esplora),
+        network,
+        bridge::constants::DestinationNetwork::Local,
+        Some(get_chain_adaptor(bridge::constants::DestinationNetwork::Local, None, None)),
+        &n_of_n,
+        None, // no depositor key here: depositor wallet signs peg-in itself
+        Some(&osec),
+        None,
+        None,
+        Some("fpl_ceremony_coordinator"),
+        None,
+    )
+    .await;
+    let mut pairs = vec![];
+    for q in &queue {
+        // peg-in graph signed by the depositor's own wallet (fpl_depositor)
+        let p = dir.join("peg_in_signed.json");
+        let t0 = std::time::Instant::now();
+        while !p.exists() { assert!(t0.elapsed() < timeout, "no peg_in_signed.json"); std::thread::sleep(Duration::from_millis(500)); }
+        std::thread::sleep(Duration::from_millis(500));
+        let g: bridge::graphs::peg_in::PegInGraph = serde_json::from_slice(&std::fs::read(&p).unwrap()).unwrap();
+        let prev = g.fpl_deposit_prevouts();
+        assert_eq!(prev, vec![OutPoint::from_str(&q.deposit_outpoint).unwrap()], "depositor graph spends a different outpoint");
+        assert_eq!(g.depositor_evm_address, q.evm_address, "evm address mismatch");
+        g.validate().expect("depositor peg-in graph invalid");
+        assert_eq!(g.fpl_n_of_n_public_keys(), &n_of_n[..], "depositor graph uses a different n-of-n");
+        let _ = q.deposit_amount;
+        let peg_in = g.id().clone();
+        client.data_mut().peg_in_graphs.push(g);
+        let peg_out = client.create_peg_out_graph(
+            &peg_in,
+            Input { outpoint: OutPoint::from_str(&q.kickoff_outpoint).unwrap(), amount: Amount::from_sat(q.kickoff_amount) },
+            match arg(&a, "--pregen-pool") {
+                // pre-generated WOTS set: connector C already cached (fpl_pregen, same cwd)
+                Some(pool) => {
+                    let ready = std::path::Path::new(&pool).join("ready");
+                    let mut ents: Vec<_> = std::fs::read_dir(&ready).expect("pool/ready").filter_map(|e| e.ok()).map(|e| e.path()).filter(|p| p.extension().map(|x| x == "json").unwrap_or(false)).collect();
+                    ents.sort();
+                    let e = ents.first().expect("pregen pool empty: run fpl_pregen").clone();
+                    let used = std::path::Path::new(&pool).join("used").join(e.file_name().unwrap());
+                    std::fs::rename(&e, &used).unwrap(); // claim once, before use
+                    println!("using pregenerated WOTS set {}", e.file_name().unwrap().to_string_lossy());
+                    serde_json::from_slice(&std::fs::read(&used).unwrap()).unwrap()
+                }
+                None => CommitmentMessageId::generate_commitment_secrets(),
+            },
+        );
+        println!("peg-in graph {peg_in}  peg-out graph {peg_out}");
+        pairs.push((peg_in, peg_out));
+    }
+
+    fpl_ceremony::publish_graphs(
+        &dir,
+        &fpl_ceremony::GraphsFile {
+            network,
+            n_of_n_public_keys: n_of_n.clone(),
+            signing_order: seats.clone(),
+            data: client.data().clone(),
+        },
+    );
+    let (signed, atts) = fpl_ceremony::coordinate(&dir, &seats, timeout).unwrap();
+    for at in &atts {
+        println!("attestation {} verifies={} transcript={}", at.id, at.verify(), at.transcript_sha256);
+    }
+    let all_presigned = pairs.iter().all(|(pi, _)| {
+        signed.peg_in_graphs.iter().find(|g| g.id() == pi).map(|g| g.peg_in_confirm_transaction_ref().has_all_signatures()).unwrap_or(false)
+    });
+    let cc: Vec<String> = signed.peg_out_graphs.iter().map(|g| g.fpl_connector_c_spk().to_hex_string()).collect();
+    std::fs::write(dir.join("connector_c_spks.txt"), cc.join("\n") + "\n").unwrap();
+    let transcript = serde_json::json!({
+        "connector_c_spks": cc,
+        "network": format!("{network}"),
+        "seats": pubs.iter().map(|p| serde_json::json!({"id": p.id, "pubkey": p.public_key.to_string()})).collect::<Vec<_>>(),
+        "graphs": pairs.iter().map(|(i, o)| serde_json::json!({"peg_in": i, "peg_out": o})).collect::<Vec<_>>(),
+        "attestations": atts,
+        "nonced_sha256": atts.first().map(|x| x.transcript_sha256.clone()),
+        "all_peg_ins_presigned": all_presigned,
+    });
+    std::fs::write(dir.join("transcript.json"), serde_json::to_vec_pretty(&transcript).unwrap()).unwrap();
+    client.merge_data(signed);
+
+    if a.iter().any(|x| x == "--broadcast") {
+        for (peg_in, _) in &pairs {
+            binding_gate(&a, network, client.data(), peg_in);
+        }
+        for (peg_in, _) in &pairs {
+            let t = client.broadcast_peg_in_deposit(peg_in).await;
+            println!("peg-in deposit {peg_in}: {t:?}");
+        }
+        for (peg_in, _) in &pairs {
+            // re-check right before the confirm (bindings/registry may have changed)
+            binding_gate(&a, network, client.data(), peg_in);
+            loop {
+                match client.broadcast_peg_in_confirm(peg_in).await {
+                    Ok(txid) => {
+                        println!("peg-in confirm {peg_in}: {txid} (depositor+signer MuSig2)");
+                        break;
+                    }
+                    Err(e) => {
+                        println!("waiting for deposit confirmation ({e:?})");
+                        tokio::time::sleep(Duration::from_secs(2)).await;
+                    }
+                }
+            }
+        }
+    }
+    println!("ceremony complete; final.json + transcript.json in {}", dir.display());
+
+    // Live operator scenario (testnet4 runbook a / e), same process (keeps WOTS secrets in RAM).
+    if let Some(sc) = arg(&a, "--scenario") {
+        run_scenario(&mut client, &a, &dir, &pairs[0].1, network, &sc).await;
+    }
+}
+
+/// BRIDGE refusal rule gate: exits the process (code 3) instead of broadcasting
+/// a peg-in whose operator graphs are not all bound on the Falcon ledger.
+fn binding_gate(a: &[String], network: Network, data: &bridge::client::client::BitVMClientPublicData, peg_in: &str) {
+    use bridge::fpl_bindings;
+    let status = if let Some(f) = arg(a, "--bindings-status") {
+        Some(fpl_bindings::status_from_file(std::path::Path::new(&f)))
+    } else if let Some(ctl) = arg(a, "--falcon-ctl").or_else(|| std::env::var("FPL_FALCON_CTL").ok()) {
+        let rpc = arg(a, "--falcon-rpc").or_else(|| std::env::var("FPL_FALCON_RPC").ok()).unwrap_or_default();
+        Some(fpl_bindings::status_from_ctl(&ctl, &rpc))
+    } else {
+        None
+    };
+    match status {
+        None if a.iter().any(|x| x == "--no-binding-check") => {
+            println!("BINDING_CHECK skipped (--no-binding-check) for peg-in {peg_in}");
+        }
+        None if network == Network::Regtest => {
+            println!("BINDING_CHECK not configured (regtest): peg-in {peg_in} not checked");
+        }
+        None => {
+            eprintln!("BINDING_CHECK REFUSE: no Falcon status source (--falcon-ctl / --bindings-status); pass --no-binding-check only before the bridge height");
+            std::process::exit(3);
+        }
+        Some(Err(e)) => {
+            eprintln!("BINDING_CHECK REFUSE: cannot read Falcon status: {e}");
+            std::process::exit(3);
+        }
+        Some(Ok(st)) => match fpl_bindings::check_peg_in(data, peg_in, &st) {
+            Ok(fpl_bindings::Verdict::Inactive) => println!("BINDING_CHECK bridge not active on the ledger yet: peg-in {peg_in} not enforced"),
+            Ok(fpl_bindings::Verdict::Bound(n)) => println!("BINDING_CHECK OK: {n} operator graph(s) bound and matching for peg-in {peg_in}"),
+            Err(e) => {
+                eprintln!("BINDING_CHECK {e} (peg-in {peg_in}); nothing broadcast");
+                std::process::exit(3);
+            }
+        },
+    }
+}
+
+fn is_done(e: &str) -> bool {
+    e.contains("already in block chain") || e.contains("txn-already-known") || e.contains("txn-already-in-mempool") || e.contains("-27")
+}
+
+macro_rules! retry {
+    ($name:expr, $call:expr) => {{
+        loop {
+            match $call {
+                Ok(t) => { println!("TX {} {}", $name, t); break }
+                Err(e) => {
+                    let es = format!("{e:?}");
+                    if is_done(&es) { println!("TX {} already broadcast", $name); break }
+                    println!("waiting: {}: {}", $name, &es[..es.len().min(240)]);
+                    tokio::time::sleep(Duration::from_secs(120)).await;
+                }
+            }
+        }
+    }};
+}
+
+/// FPL disprove scenario tail (after KICK_OFF_1). See module doc.
+async fn fpl_disprove_flow(client: &mut BitVMClient, po: &String, dir: &std::path::Path) {
+    use bridge::transactions::pre_signed::PreSignedTransaction;
+    let wait_file = |name: &'static str| {
+        let f = dir.join(name);
+        async move {
+            loop {
+                if let Ok(s) = std::fs::read_to_string(&f) {
+                    let s = s.trim().to_string();
+                    if !s.is_empty() { return s; }
+                }
+                tokio::time::sleep(Duration::from_secs(10)).await;
+            }
+        }
+    };
+    let (confirm, opx) = {
+        let g = client.data().peg_out_graphs.iter().find(|g| g.id() == po).unwrap();
+        let pi = client.data().peg_in_graphs.iter().find(|x| x.id() == g.fpl_peg_in_graph_id()).unwrap();
+        (pi.peg_in_confirm_transaction_ref().tx().compute_txid(), g.fpl_operator_public_key().inner.x_only_public_key().0.to_string())
+    };
+    println!("CHALLENGE_NEEDED {confirm}:0 {opx}");
+    let ch = wait_file("challenge.txt").await;
+    let cht = bitcoin::Txid::from_str(&ch).expect("challenge.txt: txid");
+    loop {
+        if client.esplora.get_tx_status(&cht).await.map(|s| s.confirmed).unwrap_or(false) { break; }
+        tokio::time::sleep(Duration::from_secs(30)).await;
+    }
+    println!("CHALLENGE_CONFIRMED {ch}");
+    retry!("START_TIME", { client.broadcast_start_time(po).await });
+    retry!("KICK_OFF_2", { client.broadcast_kick_off_2(po).await });
+    retry!("ASSERT_INITIAL", { client.broadcast_assert_initial(po).await });
+    // dishonest operator: a Groth16 proof that does not verify under the deployment VK
+    let mut bad = bridge::proof::get_proof();
+    bad.proof.a = -bad.proof.a;
+    retry!("ASSERT_COMMITS (invalid proof)", { client.broadcast_assert_commits(po, &bad).await.map(|(a, b)| format!("{a} {b}")) });
+    retry!("ASSERT_FINAL", { client.broadcast_assert_final(po).await });
+    println!("ASSERTED_INVALID");
+    let d = wait_file("disprove.txt").await;
+    let dt = bitcoin::Txid::from_str(&d).expect("disprove.txt: txid");
+    loop {
+        if client.esplora.get_tx_status(&dt).await.map(|s| s.confirmed).unwrap_or(false) { break; }
+        tokio::time::sleep(Duration::from_secs(30)).await;
+    }
+    println!("DISPROVE_CONFIRMED {d}");
+    let t1 = client.broadcast_take_1(po).await;
+    let t2 = client.broadcast_take_2(po).await;
+    let short = |r: &Result<bitcoin::Txid, bridge::error::Error>| r.as_ref().map(|t| t.to_string()).map_err(|e| format!("{e:?}").chars().take(200).collect::<String>());
+    println!("take1 after disprove (must fail): {:?}", short(&t1));
+    println!("take2 after disprove (must fail): {:?}", short(&t2));
+    assert!(t1.is_err() && t2.is_err(), "operator still able to take after Disprove");
+}
+
+async fn run_scenario(client: &mut BitVMClient, a: &[String], dir: &std::path::Path, peg_out: &String, network: Network, sc: &str) {
+    use bitcoin::secp256k1::{rand::thread_rng, SecretKey};
+    use bridge::client::chain::{chain::{Chain, PegOutEvent}, mock_adaptor::{MockAdaptor, MockAdaptorConfig}};
+    use bridge::transactions::pre_signed::PreSignedTransaction;
+    use std::os::unix::fs::PermissionsExt;
+    let req = |k: &str| arg(a, k).unwrap_or_else(|| panic!("missing {k}"));
+    // withdrawer / timeout-recipient key: ours (testnet), saved 0600 so funds are recoverable
+    let wp = dir.join("withdrawer.secret");
+    if !wp.exists() {
+        std::fs::write(&wp, SecretKey::new(&mut thread_rng()).display_secret().to_string()).unwrap();
+        std::fs::set_permissions(&wp, std::fs::Permissions::from_mode(0o600)).unwrap();
+    }
+    let (_, wpk) = bridge::contexts::base::generate_keys_from_secret(network, &std::fs::read_to_string(&wp).unwrap());
+    let spk = bridge::scripts::generate_pay_to_pubkey_script(&wpk);
+    let peg_in_id = client.data().peg_out_graphs.iter().find(|g| g.id() == peg_out).unwrap().fpl_peg_in_graph_id().clone();
+    let pi = client.data().peg_in_graphs.iter().find(|g| g.id() == &peg_in_id).unwrap().clone();
+    let confirm = pi.peg_in_confirm_transaction_ref().tx().clone();
+    let opk = {
+        let (_, k) = bridge::contexts::base::generate_keys_from_secret(network, &std::env::var("FPL_OPERATOR_SECRET").unwrap());
+        k
+    };
+    // Withdrawal request: from the Falcon ledger (--falcon-claims FILE written by
+    // fpl-operatord, see bridge::client::chain::falcon_adaptor); without it the
+    // event is SIMULATED (mock adaptor; regtest/testnet4 scenarios only).
+    if let Some(cf) = arg(a, "--falcon-claims") {
+        use bridge::client::chain::falcon_adaptor::FalconAdaptor;
+        client.set_chain_service(Chain::new(Box::new(FalconAdaptor { claims_file: cf.into(), network })));
+    } else {
+    let ev = PegOutEvent {
+        source_outpoint: OutPoint { txid: confirm.compute_txid(), vout: 0 },
+        amount: confirm.output[0].value,
+        timestamp: arg(a, "--event-timestamp").map(|t| t.parse().expect("--event-timestamp")).unwrap_or_else(|| std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() as u32),
+        withdrawer_chain_address: "0x70997970C51812dc3A010C7d01b50e0d17dc79C8".into(),
+        withdrawer_destination_address: bridge::scripts::generate_p2pkh_address(network, &wpk).to_string(),
+        withdrawer_public_key_hash: wpk.pubkey_hash(),
+        operator_public_key: opk,
+        tx_hash: [0u8; 4].into(),
+    };
+    client.set_chain_service(Chain::new(Box::new(MockAdaptor::new(Some(MockAdaptorConfig {
+        peg_out_init_events: Some(vec![ev]), peg_out_burnt_events: None, peg_out_minted_events: None,
+    })))));
+    }
+    client.sync_l2().await;
+    let need = confirm.output[0].value;
+    let payout_op = match arg(a, "--payout-outpoint") {
+        Some(o) => o,
+        None => {
+            let addr = bridge::scripts::generate_pay_to_pubkey_script_address(network, &opk);
+            println!("PAYOUT_NEEDED {addr} {}", need.to_sat());
+            let f = dir.join("payout.txt");
+            while !f.exists() { tokio::time::sleep(Duration::from_secs(5)).await; }
+            tokio::time::sleep(Duration::from_secs(1)).await;
+            std::fs::read_to_string(&f).unwrap().trim().to_string()
+        }
+    };
+    let _ = req;
+    let payout = Input { outpoint: OutPoint::from_str(&payout_op).unwrap(), amount: need };
+    let po = peg_out.clone();
+    let _ = &po;
+    // resume after a crash: the PEG_OUT may already be on chain (same event timestamp => same tx);
+    // a confirmed tx whose input is spent returns -25 missingorspent, so check the payout outspend.
+    let spent_by = client.esplora.get_output_status(&payout.outpoint.txid, payout.outpoint.vout as u64).await.ok().flatten().filter(|s| s.spent).and_then(|s| s.txid);
+    if let Some(sp) = spent_by {
+        // builds + stores the graph's PEG_OUT (broadcast fails: already mined), then require it IS the spender
+        let r = client.broadcast_peg_out(&po, Input { outpoint: payout.outpoint, amount: payout.amount }).await;
+        let mine = client.data().peg_out_graphs.iter().find(|g| g.id() == &po).and_then(|g| g.peg_out_transaction.as_ref()).map(|t| { use bridge::transactions::pre_signed::PreSignedTransaction; t.tx().compute_txid() });
+        assert_eq!(mine, Some(sp), "payout spent by a different tx than this graph's PEG_OUT ({r:?})");
+        println!("TX PEG_OUT (operator pays withdrawer) {sp} (already on chain)");
+    } else {
+        retry!("PEG_OUT (operator pays withdrawer)", { client.broadcast_peg_out(&po, Input { outpoint: payout.outpoint, amount: payout.amount }).await });
+    }
+    // public PEG_OUT / KICK_OFF_1 txids for fpl-operatord (gossiped; watchers verify the exact payout script)
+    {
+        use bridge::transactions::pre_signed::PreSignedTransaction;
+        let g = client.data().peg_out_graphs.iter().find(|g| g.id() == &po).unwrap();
+        if let Some(t) = g.peg_out_transaction.as_ref() {
+            std::fs::write(dir.join("peg_out.txid"), format!("{}\n", t.tx().compute_txid())).unwrap();
+        }
+        std::fs::write(dir.join("kick_off_1.txid"), format!("{}\n", g.fpl_watch_txids().kick_off_1)).unwrap();
+    }
+    retry!("PEG_OUT_CONFIRM", { client.broadcast_peg_out_confirm(&po).await });
+    retry!("KICK_OFF_1", { client.sync().await; client.broadcast_kick_off_1(&po).await });
+    match sc {
+        "take1" => {
+            retry!("START_TIME", { client.broadcast_start_time(&po).await });
+            retry!("KICK_OFF_2", { client.broadcast_kick_off_2(&po).await });
+            retry!("TAKE_1", { client.broadcast_take_1(&po).await });
+        }
+        "timeouts" => {
+            // operator stalls after kickoff 1: anyone claims via the presigned timeouts
+            retry!("START_TIME_TIMEOUT", { client.broadcast_start_time_timeout(&po, spk.clone()).await });
+            retry!("KICK_OFF_TIMEOUT", { client.broadcast_kick_off_timeout(&po, spk.clone()).await });
+            let r = client.broadcast_take_1(&po).await;
+            println!("take1 after timeouts (must fail): {:?}", r.as_ref().map(|t| t.to_string()).map_err(|e| format!("{e:?}").chars().take(200).collect::<String>()));
+        }
+        "disprove" => fpl_disprove_flow(client, &po, dir).await,
+        s => panic!("unknown scenario {s}"),
+    }
+    println!("SCENARIO {sc} DONE");
+}
+
+/// FPL resume path: rebuild the coordinator client from disk after a restart.
+async fn resume(a: &[String], dir: &std::path::Path, network: Network, esplora: &str, osec: &str) {
+    let tr: serde_json::Value = serde_json::from_slice(&std::fs::read(dir.join("transcript.json")).expect("transcript.json")).unwrap();
+    assert_eq!(tr["network"].as_str().unwrap(), format!("{network}"), "network mismatch");
+    let n_of_n: Vec<bitcoin::PublicKey> = tr["seats"].as_array().unwrap().iter()
+        .map(|s| bitcoin::PublicKey::from_str(s["pubkey"].as_str().unwrap()).unwrap()).collect();
+    let peg_out = tr["graphs"][0]["peg_out"].as_str().expect("graph").to_string();
+    let mut client = BitVMClient::new(
+        Some(esplora), network, bridge::constants::DestinationNetwork::Local,
+        Some(get_chain_adaptor(bridge::constants::DestinationNetwork::Local, None, None)),
+        &n_of_n, None, Some(osec), None, None, Some("fpl_ceremony_coordinator"), None,
+    ).await;
+    let fin: bridge::client::client::BitVMClientPublicData =
+        serde_json::from_slice(&std::fs::read(dir.join("final.json")).expect("final.json")).expect("parse final.json");
+    client.merge_data(fin);
+    if a.iter().any(|x| x == "--broadcast-peg-in") {
+        // intake service: ceremony finished, operators bound on the ledger -> deposit + confirm
+        let peg_in = tr["graphs"][0]["peg_in"].as_str().expect("peg_in").to_string();
+        binding_gate(a, network, client.data(), &peg_in);
+        let t = client.broadcast_peg_in_deposit(&peg_in).await;
+        println!("peg-in deposit {peg_in}: {t:?}");
+        binding_gate(a, network, client.data(), &peg_in);
+        loop {
+            match client.broadcast_peg_in_confirm(&peg_in).await {
+                Ok(txid) => { println!("peg-in confirm {peg_in}: {txid} (depositor+signer MuSig2)"); break; }
+                Err(e) => { println!("waiting for deposit confirmation ({e:?})"); tokio::time::sleep(Duration::from_secs(10)).await; }
+            }
+        }
+        return;
+    }
+    let g = client.data().peg_out_graphs.iter().find(|g| g.id() == &peg_out).expect("peg-out graph not in final.json").clone();
+    let pi = client.data().peg_in_graphs.iter().find(|x| x.id() == g.fpl_peg_in_graph_id()).expect("peg-in graph missing");
+    let confirm_ok = pi.peg_in_confirm_transaction_ref().has_all_signatures();
+    let presigned = g.has_all_signatures(&n_of_n);
+    let (_, opk) = bridge::contexts::base::generate_keys_from_secret(network, osec);
+    let secrets = client.private_data().commitment_secrets.get(&opk).and_then(|m| m.get(&peg_out));
+    let n_secrets = secrets.map(|m| m.len()).unwrap_or(0);
+    let secrets_ok = secrets.map(|m| g.fpl_commitment_secrets_match(m)).unwrap_or(false);
+    let w = g.fpl_watch_txids();
+    println!("RESUME graph {peg_out} peg_in_confirm_presigned={confirm_ok} n_of_n_presigned={presigned} wots_secrets={n_secrets} wots_match={secrets_ok}");
+    println!("RESUME kick_off_1 {} kick_off_2 {} take_1 {}", w.kick_off_1, w.kick_off_2, w.take_1);
+    println!("RESUME start_time_height {}", bridge::superblock::get_start_time_block_number(network));
+    assert!(confirm_ok && presigned && secrets_ok, "resume check FAILED");
+    println!("RESUME OK");
+    if a.iter().any(|x| x == "--resume-check") { return; }
+    let sc = arg(a, "--scenario").expect("--scenario");
+    if arg(a, "--payout-outpoint").is_some() {
+        // resume BEFORE the peg-out: peg-in confirmed, operator payout funded (--payout-outpoint
+        // txid:vout), PEG_OUT/PEG_OUT_CONFIRM/KICK_OFF_1 not yet broadcast -> run the full scenario
+        // tail (reuses <dir>/withdrawer.secret; already-broadcast txs are treated as done).
+        run_scenario(&mut client, a, dir, &peg_out, network, &sc).await;
+        return;
+    }
+    let spk = {
+        let wp = dir.join("withdrawer.secret");
+        let (_, wpk) = bridge::contexts::base::generate_keys_from_secret(network, std::fs::read_to_string(&wp).expect("withdrawer.secret").trim());
+        bridge::scripts::generate_pay_to_pubkey_script(&wpk)
+    };
+    let po = peg_out;
+    match sc.as_str() {
+        "take1" => {
+            retry!("START_TIME", { client.broadcast_start_time(&po).await });
+            retry!("KICK_OFF_2", { client.broadcast_kick_off_2(&po).await });
+            retry!("TAKE_1", { client.broadcast_take_1(&po).await });
+        }
+        "timeouts" => {
+            retry!("START_TIME_TIMEOUT", { client.broadcast_start_time_timeout(&po, spk.clone()).await });
+            retry!("KICK_OFF_TIMEOUT", { client.broadcast_kick_off_timeout(&po, spk.clone()).await });
+        }
+        "disprove" => fpl_disprove_flow(&mut client, &po, dir).await,
+        s => panic!("unknown scenario {s}"),
+    }
+    println!("SCENARIO {sc} (resumed) DONE");
+}
diff --git a/bridge/examples/fpl_ceremony_participant.rs b/bridge/examples/fpl_ceremony_participant.rs
new file mode 100644
index 0000000..e2a17b0
--- /dev/null
+++ b/bridge/examples/fpl_ceremony_participant.rs
@@ -0,0 +1,21 @@
+//! Per-machine ceremony participant. Run one per seat machine:
+//!   fpl_ceremony_participant --dir <exchange-dir> --id <seat-name> [--timeout-secs N]
+//! The verifier key exists only in this process's RAM and is wiped before
+//! exit; only public data and the deletion attestation are written.
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let get = |k: &str| a.iter().position(|x| x == k).map(|i| a[i + 1].clone());
+    let dir = std::path::PathBuf::from(get("--dir").expect("--dir"));
+    let id = get("--id").expect("--id");
+    let t = get("--timeout-secs").map(|s| s.parse().unwrap()).unwrap_or(3600);
+    match bridge::fpl_ceremony::participant(&dir, &id, std::time::Duration::from_secs(t)) {
+        Ok(att) => {
+            println!("{}", serde_json::to_string_pretty(&att).unwrap());
+            println!("key wiped; attestation verifies: {}", att.verify());
+        }
+        Err(e) => {
+            eprintln!("ceremony aborted: {e}");
+            std::process::exit(1);
+        }
+    }
+}
diff --git a/bridge/examples/fpl_challenge.rs b/bridge/examples/fpl_challenge.rs
new file mode 100644
index 0000000..7d05e91
--- /dev/null
+++ b/bridge/examples/fpl_challenge.rs
@@ -0,0 +1,322 @@
+//! fpl_challenge: build + broadcast the BitVM2 Challenge for another operator's bad
+//! kickoff, funded from THIS operator's own bitcoind wallet; optionally follow the
+//! graph and broadcast Disprove / Disprove-chain (non-standard -> miner channels).
+//!
+//!   fpl_challenge --network regtest|testnet4 --deposit TXID:VOUT --operator XONLY_HEX
+//!     [--graphs DIR] [--esplora URL] [--bitcoin-cli PATH] [--state FILE]
+//!     [--submit submit.json] [--vk-dir DIR --follow [--follow-secs N]] [--dry-run]
+//!
+//! Env: FPL_OPERATOR_SECRET (funding/refund key; never printed), FPL_OP_HOME
+//! (defaults for --graphs/--state/--submit), FPL_DRY_RUN=1 (= --dry-run).
+//! Output lines parsed by fpl-operatord:
+//!   CHALLENGE_TXID <txid>       broadcast by us now
+//!   ALREADY_CHALLENGED <txid|spent>  idempotent: no second challenge
+//!   DRY_RUN <plan>              nothing funded or broadcast
+//!   DISPROVE_TXID <txid>        (with --follow)
+//!   --print-payout-spk DEST OPEN_HEIGHT NOTE_ID  (exact PEG_OUT output script)
+//! Exit 0 done, 75 = not ready yet (kick-off 1 unconfirmed; retry later), other = error.
+//! Idempotence: (1) state file keyed by peg-out graph id, (2) on-chain: if connector A
+//! (kick-off 1 output spent by Challenge) is already spent, we never build another.
+use std::{collections::BTreeMap, path::PathBuf, process::Command, str::FromStr, time::Duration};
+
+use bitcoin::{consensus::encode::serialize_hex, Amount, Network, OutPoint, Txid};
+use bridge::{
+    client::client::BitVMClientPublicData,
+    fpl_watcher::{self, GraphWatchState, SubmitChannel, SubmitConfig, WatchAction, WatcherIdentity},
+    graphs::{base::BaseGraph, peg_out::PegOutGraph},
+    scripts::{generate_pay_to_pubkey_script, generate_pay_to_pubkey_script_address},
+    transactions::base::InputWithScript,
+};
+use esplora_client::Builder;
+use serde::{Deserialize, Serialize};
+
+fn arg(a: &[String], k: &str) -> Option<String> {
+    a.iter().position(|x| x == k).and_then(|i| a.get(i + 1).cloned())
+}
+
+#[derive(Default, Serialize, Deserialize)]
+struct Entry {
+    deposit: String,
+    operator: String,
+    funding_outpoint: Option<String>,
+    challenge_txid: Option<String>,
+    disprove_txid: Option<String>,
+    log: Vec<String>,
+}
+
+fn load_state(p: &PathBuf) -> BTreeMap<String, Entry> {
+    std::fs::read_to_string(p).ok().and_then(|s| serde_json::from_str(&s).ok()).unwrap_or_default()
+}
+fn save_state(p: &PathBuf, s: &BTreeMap<String, Entry>) {
+    if let Some(d) = p.parent() {
+        let _ = std::fs::create_dir_all(d);
+    }
+    let tmp = p.with_extension("tmp");
+    std::fs::write(&tmp, serde_json::to_vec_pretty(s).unwrap()).unwrap();
+    std::fs::rename(&tmp, p).unwrap();
+}
+
+fn cli(bin: &str, args: &[&str]) -> Result<String, String> {
+    let mut parts = bin.split_whitespace();
+    let prog = parts.next().ok_or("empty bitcoin-cli")?;
+    let o = Command::new(prog).args(parts).args(args).output().map_err(|e| format!("{prog}: {e}"))?;
+    if o.status.success() {
+        Ok(String::from_utf8_lossy(&o.stdout).trim().to_string())
+    } else {
+        Err(String::from_utf8_lossy(&o.stderr).trim().to_string())
+    }
+}
+
+/// Find the peg-out graph of `operator` (x-only hex) on deposit `confirm` among graphs/*/final.json.
+fn find_graph(graphs: &PathBuf, confirm: &OutPoint, operator: &str) -> Result<PegOutGraph, String> {
+    let mut seen = 0;
+    for e in std::fs::read_dir(graphs).map_err(|e| format!("{}: {e}", graphs.display()))?.flatten() {
+        let f = e.path().join("final.json");
+        let Ok(b) = std::fs::read(&f) else { continue };
+        let Ok(d) = serde_json::from_slice::<BitVMClientPublicData>(&b) else { continue };
+        seen += 1;
+        let pi_ok = d.peg_in_graphs.iter().any(|g| {
+            use bridge::transactions::pre_signed::PreSignedTransaction;
+            g.peg_in_confirm_transaction_ref().tx().compute_txid() == confirm.txid
+        });
+        if !pi_ok {
+            continue;
+        }
+        for g in d.peg_out_graphs {
+            let x = g.fpl_operator_public_key().inner.x_only_public_key().0.to_string();
+            if x.eq_ignore_ascii_case(operator) {
+                return Ok(g);
+            }
+        }
+    }
+    Err(format!("no peg-out graph for operator {operator} on deposit {confirm} ({seen} graph files)"))
+}
+
+#[tokio::main]
+async fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let code = run(&a).await;
+    std::process::exit(code);
+}
+
+async fn run(a: &[String]) -> i32 {
+    let home = std::env::var("FPL_OP_HOME").ok().map(PathBuf::from);
+    let network = match arg(a, "--network").as_deref().unwrap_or("testnet4") {
+        "regtest" => Network::Regtest,
+        "testnet4" => Network::Testnet4,
+        "signet" => Network::Signet,
+        "mainnet" | "bitcoin" => {
+            eprintln!("mainnet disabled until the bridge activates");
+            return 2;
+        }
+        n => {
+            eprintln!("unsupported network {n}");
+            return 2;
+        }
+    };
+    // helper: exact PEG_OUT payout scriptPubKey for a Falcon claim (watcher cross-check)
+    if let Some(i) = a.iter().position(|x| x == "--print-payout-spk") {
+        let (dest, h, note) = (&a[i + 1], a[i + 2].parse::<u32>().unwrap(), &a[i + 3]);
+        let pkh = bridge::client::chain::falcon_adaptor::dest_pubkey_hash(dest, network).unwrap();
+        let addr = bridge::scripts::generate_pay_to_pubkey_hash_with_inscription_script_address(network, &pkh, h, note);
+        println!("{}", addr.script_pubkey().to_hex_string());
+        return 0;
+    }
+    let (Some(dep), Some(operator)) = (arg(a, "--deposit"), arg(a, "--operator")) else {
+        eprintln!("need --deposit TXID:VOUT --operator XONLY");
+        return 2;
+    };
+    let Ok(confirm) = OutPoint::from_str(&dep) else {
+        eprintln!("bad --deposit {dep}");
+        return 2;
+    };
+    let dry = a.iter().any(|x| x == "--dry-run") || std::env::var("FPL_DRY_RUN").map(|v| v == "1").unwrap_or(false);
+    let graphs = arg(a, "--graphs").map(PathBuf::from).or(home.as_ref().map(|h| h.join("graphs"))).expect("--graphs or FPL_OP_HOME");
+    let state_p = arg(a, "--state").map(PathBuf::from).or(home.as_ref().map(|h| h.join("state/fpl_challenge.json"))).expect("--state or FPL_OP_HOME");
+    let esplora_url = arg(a, "--esplora").or(std::env::var("FPL_ESPLORA").ok()).unwrap_or_else(|| match network {
+        Network::Regtest => "http://127.0.0.1:8094/regtest/api".into(),
+        _ => "https://mempool.space/testnet4/api".into(),
+    });
+    let btc_cli = arg(a, "--bitcoin-cli").or(std::env::var("FPL_OP_BITCOIN_CLI").ok()).unwrap_or("bitcoin-cli".into());
+    let mut cfg: SubmitConfig = arg(a, "--submit")
+        .map(PathBuf::from)
+        .or(home.as_ref().map(|h| h.join("submit.json")).filter(|p| p.exists()))
+        .and_then(|p| std::fs::read_to_string(p).ok())
+        .and_then(|s| serde_json::from_str(&s).ok())
+        .unwrap_or_default();
+    if cfg.standard.is_empty() {
+        cfg.standard.push(SubmitChannel::Esplora { url: esplora_url.clone() });
+    }
+
+    let mut g = match find_graph(&graphs, &confirm, &operator) {
+        Ok(g) => g,
+        Err(e) => {
+            eprintln!("{e}");
+            return 3;
+        }
+    };
+    let gid = g.id().clone();
+    let mut state = load_state(&state_p);
+    let ent = state.entry(gid.clone()).or_insert_with(|| Entry { deposit: dep.clone(), operator: operator.clone(), ..Default::default() });
+    let esplora = Builder::new(&esplora_url).timeout(30).build_async().expect("esplora client");
+    let t = g.fpl_watch_txids();
+
+    let challenged_txid = ent.challenge_txid.clone();
+    // on-chain idempotence: connector A already spent => challenged (by us or another watcher)
+    let conn_a = g.fpl_challenge_prevout();
+    let k1 = esplora.get_tx_status(&t.kick_off_1).await.map(|s| s.confirmed).unwrap_or(false);
+    let os = esplora.get_output_status(&conn_a.txid, conn_a.vout as u64).await.ok().flatten();
+    // own node as well (esplora shims may lack /outspend): gettxout is null once spent (incl. mempool)
+    let node_spent = k1 && matches!(cli(&btc_cli, &["gettxout", &conn_a.txid.to_string(), &conn_a.vout.to_string()]), Ok(o) if o.is_empty());
+    let spent = os.as_ref().map(|s| s.spent).unwrap_or(false) || node_spent;
+    if let Some(tx) = &challenged_txid {
+        println!("ALREADY_CHALLENGED {tx}");
+    } else if spent {
+        let by = os.and_then(|s| s.txid).map(|t| t.to_string()).unwrap_or("spent".into());
+        println!("ALREADY_CHALLENGED {by}");
+        ent.log.push(format!("connector A spent by {by}"));
+        if by != "spent" {
+            ent.challenge_txid = Some(by);
+        }
+        save_state(&state_p, &state);
+    } else {
+        if !k1 {
+            println!("NOT_READY kick-off 1 {} not confirmed", t.kick_off_1);
+            return 75;
+        }
+        let need = g.fpl_challenge_crowdfunding_amount();
+        let Ok(secret) = std::env::var("FPL_OPERATOR_SECRET") else {
+            eprintln!("FPL_OPERATOR_SECRET not set");
+            return 2;
+        };
+        let (kp, pk) = bridge::contexts::base::generate_keys_from_secret(network, secret.trim());
+        let addr = generate_pay_to_pubkey_script_address(network, &pk);
+        if dry {
+            println!("DRY_RUN would fund {} sats to own challenge key {addr} and broadcast Challenge for graph {gid} (kick-off 1 {})", need.to_sat(), t.kick_off_1);
+            return 0;
+        }
+        // fund the crowdfunding input from the operator's own wallet (reuse if already funded)
+        let funding = match ent.funding_outpoint.clone() {
+            Some(o) => o,
+            None => {
+                let amt = format!("{:.8}", need.to_btc());
+                let r = cli(&btc_cli, &["-named", "send", &format!("outputs={{\"{addr}\":{amt}}}")]);
+                let txid = match r.ok().and_then(|o| serde_json::from_str::<serde_json::Value>(&o).ok()).and_then(|v| v["txid"].as_str().map(String::from)) {
+                    Some(t) => t,
+                    None => match cli(&btc_cli, &["sendtoaddress", &addr.to_string(), &amt]) {
+                        Ok(t) => t,
+                        Err(e) => {
+                            eprintln!("funding the challenge from the wallet failed: {e}");
+                            return 4;
+                        }
+                    },
+                };
+                let raw = match cli(&btc_cli, &["getrawtransaction", &txid, "true"]).or_else(|_| cli(&btc_cli, &["gettransaction", &txid, "true", "true"])) {
+                    Ok(r) => r,
+                    Err(e) => {
+                        eprintln!("cannot read funding tx {txid}: {e}");
+                        return 4;
+                    }
+                };
+                let v: serde_json::Value = serde_json::from_str(&raw).unwrap_or_default();
+                let vouts = if v["vout"].is_array() { v["vout"].clone() } else { v["decoded"]["vout"].clone() };
+                let spk = addr.script_pubkey().to_hex_string();
+                let Some(n) = vouts.as_array().into_iter().flatten().find(|o| o["scriptPubKey"]["hex"].as_str() == Some(spk.as_str())).and_then(|o| o["n"].as_u64()) else {
+                    eprintln!("funding vout not found in {txid}");
+                    return 4;
+                };
+                let o = format!("{txid}:{n}");
+                ent.funding_outpoint = Some(o.clone());
+                ent.log.push(format!("funded {o} {} sats", need.to_sat()));
+                save_state(&state_p, &state);
+                o
+            }
+        };
+        let fo = OutPoint::from_str(&funding).unwrap();
+        let script = generate_pay_to_pubkey_script(&pk);
+        let inputs = vec![InputWithScript { outpoint: fo, amount: need, script: &script }];
+        let tx = match g.challenge(&esplora, &inputs, &kp, addr.script_pubkey()).await {
+            Ok(tx) => tx,
+            Err(e) => {
+                eprintln!("challenge build failed: {e:?}");
+                return 5;
+            }
+        };
+        let txid = tx.compute_txid();
+        let hex = serialize_hex(&tx);
+        // our own node first (relays like any wallet tx), then configured channels
+        let mut ok = match cli(&btc_cli, &["sendrawtransaction", &hex]) {
+            Ok(_) => true,
+            Err(e) => {
+                eprintln!("bitcoin-cli sendrawtransaction: {e}");
+                false
+            }
+        };
+        if !ok {
+            let (o, att) = fpl_watcher::submit(&cfg, &tx).await;
+            eprintln!("submit attempts: {att:?}");
+            ok = o;
+        }
+        let ent = state.get_mut(&gid).unwrap();
+        if !ok {
+            ent.log.push(format!("challenge {txid} broadcast failed"));
+            save_state(&state_p, &state);
+            eprintln!("challenge {txid} not accepted by any channel");
+            return 6;
+        }
+        ent.challenge_txid = Some(txid.to_string());
+        ent.log.push(format!("challenge {txid} broadcast"));
+        save_state(&state_p, &state);
+        println!("CHALLENGE_TXID {txid}");
+    }
+
+    // disprove path: follow the graph (operator must Assert; a wrong Assert is disproved)
+    if a.iter().any(|x| x == "--follow") && !dry {
+        let Some(vkd) = arg(a, "--vk-dir") else {
+            eprintln!("--follow needs --vk-dir (vk.bin of the bridge circuit)");
+            return 0;
+        };
+        let vk = bridge::proof::fpl_load_vk(std::path::Path::new(&vkd));
+        let secret = std::env::var("FPL_OPERATOR_SECRET").unwrap_or_default();
+        let (kp, pk) = bridge::contexts::base::generate_keys_from_secret(network, secret.trim());
+        let reward = generate_pay_to_pubkey_script_address(network, &pk).script_pubkey();
+        let who = WatcherIdentity { challenge_inputs: vec![], challenge_keypair: kp, reward_spk: reward };
+        let mut st = GraphWatchState { challenged: true, ..Default::default() };
+        let mut bcast_disprove: Option<Txid> = load_state(&state_p).get(&gid).and_then(|e| e.disprove_txid.as_deref()).and_then(|x| Txid::from_str(x).ok());
+        let until = std::time::Instant::now() + Duration::from_secs(arg(a, "--follow-secs").and_then(|s| s.parse().ok()).unwrap_or(14 * 24 * 3600));
+        while std::time::Instant::now() < until {
+            let act = fpl_watcher::step(&esplora, &mut g, &vk, &cfg, &who, true, &mut st).await;
+            for l in st.log.drain(..) {
+                println!("watcher: {}", &l[..l.len().min(400)]);
+                if let Some(rest) = l.strip_prefix("DISPROVE ") {
+                    if rest.contains("ok=true") {
+                        let tx = rest.split_whitespace().next().unwrap_or("").to_string();
+                        println!("DISPROVE_TXID {tx}");
+                        bcast_disprove = Txid::from_str(&tx).ok();
+                        let mut s = load_state(&state_p);
+                        if let Some(e) = s.get_mut(&gid) {
+                            e.disprove_txid = Some(tx);
+                        }
+                        save_state(&state_p, &s);
+                    }
+                }
+            }
+            if act == WatchAction::Done {
+                // The broadcast Disprove carries the watcher reward output, so its txid differs from the
+                // precomputed graph txid: check the txid actually broadcast, and wait for it to confirm.
+                let dtx = bcast_disprove.unwrap_or(t.disprove);
+                let wait_until = std::time::Instant::now() + Duration::from_secs(arg(a, "--confirm-wait-secs").and_then(|s| s.parse().ok()).unwrap_or(3600));
+                let d = loop {
+                    let c = esplora.get_tx_status(&dtx).await.map(|s| s.confirmed).unwrap_or(false);
+                    if c || std::time::Instant::now() >= wait_until { break c; }
+                    tokio::time::sleep(Duration::from_secs(10)).await;
+                };
+                println!("GRAPH_DONE disprove_txid={dtx} disprove_confirmed={d}");
+                break;
+            }
+            tokio::time::sleep(Duration::from_secs(arg(a, "--poll-secs").and_then(|s| s.parse().ok()).unwrap_or(60))).await;
+        }
+    }
+    let _ = (Amount::ZERO, Txid::from_str);
+    0
+}
diff --git a/bridge/examples/fpl_depositor.rs b/bridge/examples/fpl_depositor.rs
new file mode 100644
index 0000000..fe3a876
--- /dev/null
+++ b/bridge/examples/fpl_depositor.rs
@@ -0,0 +1,55 @@
+//! CLI depositor signer (fallback before the browser/WASM signer).
+//! Generates an ephemeral MuSig2 key in RAM, checks the deposit graph
+//! against the depositor policy, joins the presigning, wipes the key.
+//!   FPL_DEPOSITOR_WALLET_SECRET=.. fpl_depositor --dir D --funding TXID:VOUT --amount SATS
+//!     --evm-address ADDR [--network regtest|testnet4] [--connector-c-spks FILE]
+//!                 [--timeout-secs N]
+//! FILE: watcher-published connector C script_pubkeys, one hex per line.
+use std::str::FromStr;
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let get = |k: &str| a.iter().position(|x| x == k).map(|i| a[i + 1].clone());
+    if a.iter().any(|x| x == "--print-address") {
+        let network = match get("--network").as_deref().unwrap_or("regtest") {
+            "testnet4" => bitcoin::Network::Testnet4,
+            "signet" => bitcoin::Network::Signet, _ => bitcoin::Network::Regtest };
+        let (_, pk) = bridge::contexts::base::generate_keys_from_secret(network, &std::env::var("FPL_DEPOSITOR_WALLET_SECRET").expect("FPL_DEPOSITOR_WALLET_SECRET"));
+        println!("{}", bridge::scripts::generate_pay_to_pubkey_script_address(network, &pk));
+        return;
+    }
+    let dir = std::path::PathBuf::from(get("--dir").expect("--dir"));
+    let t = get("--timeout-secs").map(|s| s.parse().unwrap()).unwrap_or(1800);
+    let policy = bridge::fpl_ceremony::DepositorPolicy {
+        funding_outpoints: get("--funding").map(|s| s.split(',').map(|o| bitcoin::OutPoint::from_str(o).unwrap()).collect()).unwrap_or_default(),
+        published_connector_c_spks: get("--connector-c-spks")
+            .map(|f| std::fs::read_to_string(f).unwrap().lines().map(|l| l.trim().to_lowercase()).filter(|l| !l.is_empty()).collect())
+            .unwrap_or_default(),
+        wallet: None,
+    };
+    let mut policy = policy;
+    // Depositor's own wallet signs the deposit (env FPL_DEPOSITOR_WALLET_SECRET,
+    // read here only; never printed). Required unless --no-wallet (legacy).
+    if !a.iter().any(|x| x == "--no-wallet") {
+        let network = match get("--network").as_deref().unwrap_or("regtest") {
+            "regtest" => bitcoin::Network::Regtest,
+            "testnet4" => bitcoin::Network::Testnet4,
+            "signet" => bitcoin::Network::Signet,
+            n => panic!("unsupported network {n}"),
+        };
+        let f = get("--funding").expect("--funding");
+        policy.wallet = Some(bridge::fpl_ceremony::DepositorWallet {
+            secret_hex: std::env::var("FPL_DEPOSITOR_WALLET_SECRET").expect("FPL_DEPOSITOR_WALLET_SECRET"),
+            network,
+            deposit_input: bridge::transactions::base::Input {
+                outpoint: bitcoin::OutPoint::from_str(f.split(',').next().unwrap()).unwrap(),
+                amount: bitcoin::Amount::from_sat(get("--amount").expect("--amount").parse().unwrap()),
+            },
+            evm_address: get("--evm-address").expect("--evm-address"),
+            seats: get("--seats").unwrap_or("depositor-wallet,fpl-signer".into()).split(',').map(String::from).collect(),
+        });
+    }
+    match bridge::fpl_ceremony::participant_with_policy(&dir, "depositor-wallet", std::time::Duration::from_secs(t), Some(&policy)) {
+        Ok(att) => println!("depositor signed; key wiped; attestation verifies: {}", att.verify()),
+        Err(e) => { eprintln!("depositor refused/aborted: {e}"); std::process::exit(1) }
+    }
+}
diff --git a/bridge/examples/fpl_depositor_ext.rs b/bridge/examples/fpl_depositor_ext.rs
new file mode 100644
index 0000000..308d480
--- /dev/null
+++ b/bridge/examples/fpl_depositor_ext.rs
@@ -0,0 +1,63 @@
+//! FPL browser-depositor mode. The depositor key lives only in the user's
+//! browser wallet; this tool (run by the deposit intake, holds no secret)
+//! prepares the peg-in graph from the depositor's PUBLIC key and the
+//! operator seats' ceremony keys, emits PSBTs for the depositor's three
+//! signatures, and attaches the returned signatures (verified) as
+//! peg_in_signed.json for fpl_ceremony_coordinator.
+//!
+//!   fpl_depositor_ext prepare --dir D --depositor-pubkey 02.. --funding TXID:VOUT
+//!       --amount SATS --evm-address fpl:<account> [--network testnet4|regtest|signet]
+//!       [--seats host1,host2,seat3] [--timeout-secs N]
+//!     -> D/depositor_request.json  {graph_id, psbts:{deposit,refund,confirm}, sighashes, ...}
+//!   fpl_depositor_ext finish --dir D --signed FILE
+//!     FILE: {"deposit": psbt_hex, "refund": psbt_hex, "confirm": psbt_hex} (signed PSBTs)
+//!     -> D/peg_in_signed.json
+//!   fpl_depositor_ext address --depositor-pubkey 02.. [--network ..]   (funding address)
+use std::str::FromStr;
+
+fn net(s: Option<String>) -> bitcoin::Network {
+    match s.as_deref().unwrap_or("regtest") {
+        "testnet4" => bitcoin::Network::Testnet4,
+        "signet" => bitcoin::Network::Signet,
+        "regtest" => bitcoin::Network::Regtest,
+        n => panic!("unsupported network {n} (testnet4 only for public use)"),
+    }
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let get = |k: &str| a.iter().position(|x| x == k).map(|i| a[i + 1].clone());
+    let cmd = a.get(1).map(String::as_str).unwrap_or("");
+    let network = net(get("--network"));
+    match cmd {
+        "address" => {
+            let pk = bitcoin::PublicKey::from_str(&get("--depositor-pubkey").expect("--depositor-pubkey")).expect("pubkey");
+            println!("{}", bridge::scripts::generate_pay_to_pubkey_script_address(network, &pk));
+        }
+        "prepare" => {
+            let dir = std::path::PathBuf::from(get("--dir").expect("--dir"));
+            let t = std::time::Duration::from_secs(get("--timeout-secs").map(|s| s.parse().unwrap()).unwrap_or(1800));
+            let pk = bitcoin::PublicKey::from_str(&get("--depositor-pubkey").expect("--depositor-pubkey")).expect("pubkey");
+            let f = get("--funding").expect("--funding");
+            let input = bridge::transactions::base::Input {
+                outpoint: bitcoin::OutPoint::from_str(&f).expect("funding outpoint"),
+                amount: bitcoin::Amount::from_sat(get("--amount").expect("--amount").parse().unwrap()),
+            };
+            let seats: Vec<String> = get("--seats").unwrap_or("host1,host2,seat3".into()).split(',').map(String::from).collect();
+            let evm = get("--evm-address").expect("--evm-address");
+            match bridge::fpl_ceremony::external_depositor_prepare(&dir, network, &pk, input, &evm, &seats, t) {
+                Ok(id) => println!("prepared peg-in graph {id}; depositor_request.json written"),
+                Err(e) => { eprintln!("prepare failed: {e}"); std::process::exit(1) }
+            }
+        }
+        "finish" => {
+            let dir = std::path::PathBuf::from(get("--dir").expect("--dir"));
+            let signed: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(get("--signed").expect("--signed")).unwrap()).expect("signed json");
+            match bridge::fpl_ceremony::external_depositor_finish(&dir, &signed) {
+                Ok(id) => println!("depositor signatures verified; peg_in_signed.json written for {id}"),
+                Err(e) => { eprintln!("finish refused: {e}"); std::process::exit(1) }
+            }
+        }
+        _ => { eprintln!("usage: fpl_depositor_ext address|prepare|finish ..."); std::process::exit(2) }
+    }
+}
