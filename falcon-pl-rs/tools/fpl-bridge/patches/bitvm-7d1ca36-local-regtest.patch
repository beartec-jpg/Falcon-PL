@@ -25,11 +25,38 @@ pub const GRAPH_VERSION: &str = "0.1";
 
 //1 btc
 pub const CROWDFUNDING_AMOUNT: f64 = 1.0;
+/// FPL: Challenge crowdfunding amount per network (sats). Protocol intent: the challenger's
+/// input is paid to the OPERATOR (Challenge output 0) as an anti-griefing bond compensating the
+/// Assert set the operator is forced to post (MIN_RELAY_FEE_ASSERT_SET, ~1.26M vB: 1.26M sats at
+/// 1 sat/vB, ~157k at the tn4-lowfee 0.125 sat/vB). The asserts themselves are prefunded in
+/// PEG_OUT_FEE, so the bond only has to make griefing cost something, not fund the operator.
+/// Testnet4 / regtest: 40,000 sats (any watcher-operator can afford a challenge; ~25% of the
+/// lowfee assert cost - acceptable on test networks). Mainnet: never below the assert-set fee
+/// (upstream 1 BTC kept until the bridge economics are fixed). Baked into the presigned
+/// Challenge (n-of-n signs SINGLE|ANYONECANPAY over output 0): graphs made before this change
+/// keep their 1 BTC requirement.
+pub const FPL_CROWDFUNDING_SATS_TESTNET4: u64 = 40_000;
+pub const FPL_CROWDFUNDING_SATS_REGTEST: u64 = 40_000;
+pub fn fpl_crowdfunding_amount(network: bitcoin::Network) -> bitcoin::Amount {
+    let sats = match network {
+        bitcoin::Network::Testnet4 => FPL_CROWDFUNDING_SATS_TESTNET4,
+        bitcoin::Network::Regtest | bitcoin::Network::Signet => FPL_CROWDFUNDING_SATS_REGTEST,
+        _ => (CROWDFUNDING_AMOUNT * 100_000_000.0) as u64,
+    };
+    bitcoin::Amount::from_sat(sats.max(DUST_AMOUNT))
+}
 // for commonly used type in codebase - p2wsh txout
 // 67 = (32 + 4 + 1 + (107 / WITNESS_SCALE_FACTOR) + 4) for segwit TxOut
 // TODO: Use lower dust amount for other txout types
 pub const DUST_AMOUNT: u64 = (43 + 67) * DUST_RELAY_FEE_RATE;
 pub const MIN_RELAY_FEE_RATE: u64 = (DEFAULT_MIN_RELAY_TX_FEE / 1000) as u64;
+/// FPL: relay fee rate in sat/kvB used for presigned graph fees.
+/// Default = Core min relay (1000 sat/kvB = 1 sat/vB). Feature `fpl-tn4-lowfee`
+/// (testnet4 ONLY) = 125 sat/kvB (0.125 sat/vB; floor 0.1 is mined on testnet4).
+#[cfg(not(feature = "fpl-tn4-lowfee"))]
+pub const FPL_RELAY_FEE_SAT_PER_KVB: u64 = DEFAULT_MIN_RELAY_TX_FEE as u64;
+#[cfg(feature = "fpl-tn4-lowfee")]
+pub const FPL_RELAY_FEE_SAT_PER_KVB: u64 = 125; // 0.1 sat/vB + 25% margin: kickoff1 vsize estimate (6231) is ~5% under actual (6530)
 pub const DUST_RELAY_FEE_RATE: u64 = (DUST_RELAY_TX_FEE / 1000) as u64;
 
 // set reward percentage as 2% of peg in deposit
@@ -48,7 +75,18 @@ pub const PEG_OUT_FEE: u64 = MIN_RELAY_FEE_PEG_OUT_CONFIRM // depth 0
     + MIN_RELAY_FEE_START_TIME // include START_TIME tx, spent in kickoff 1
     + MIN_RELAY_FEE_KICK_OFF_2 // depth 2
     + MIN_RELAY_FEE_ASSERT_SET // depth 3
-    + MIN_RELAY_FEE_DISPROVE; // depth 4
+    + MIN_RELAY_FEE_DISPROVE // depth 4
+    + FPL_ASSERT_DUST_RESERVE;
+/// FPL fix: assert_initial creates one DUST output per connector E (one per
+/// Groth16 intermediate value: NUM_PUBS + NUM_U256 + NUM_HASH = 378) plus the
+/// chained commit-part links; upstream PEG_OUT_FEE did not reserve them (hidden
+/// by the 1 sat/vB fee margin; underflowed at testnet4 low fees). Not consumed on
+/// the take1 path (returns to the operator); carried forward on take2/disprove.
+pub const FPL_ASSERT_DUST_RESERVE: u64 = (bitvm::chunk::api::NUM_PUBS
+    + bitvm::chunk::api::NUM_U256
+    + bitvm::chunk::api::NUM_HASH
+    + 16) as u64
+    * DUST_AMOUNT;
 pub const PEG_IN_FEE: u64 =
     MIN_RELAY_FEE_PEG_IN_DEPOSIT + max(MIN_RELAY_FEE_PEG_IN_CONFIRM, MIN_RELAY_FEE_PEG_IN_REFUND);
 
