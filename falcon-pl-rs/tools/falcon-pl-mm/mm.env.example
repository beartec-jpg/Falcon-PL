# falcon-pl-mm dry-run config (testnet4). Keep DRY_RUN=1 until the MM wallets are funded via BTC4 peg-in.
DRY_RUN=1
ONCE=0
CTL=/var/lib/falcon-pl-mm/bin/falcon-pl-ctl
RPC_ADDR=http://127.0.0.1:8545
SCHEME=falcon
KEYS_DIR=/var/lib/falcon-pl-mm/keys
NETWORK_ID=2300
PAIR=BTC4-FPL
WALLETS=mm1,mm2,mm3,mm4,mm5,mm6,mm7,mm8
LEVELS=10
SPACING_BPS=25
QUOTE_MIN_FPL=2000
QUOTE_MAX_FPL=20000
BAND_LO=900000
BAND_HI=1100000
PERIOD_S=21600
TICK_S=60
FPL_RAW_PER_FPL=1000000
BASE_RAW_PER_COIN=100000000
MM_PAUSE=/var/lib/falcon-pl-mm/MM_PAUSE
MM_CANCEL_ALL=/var/lib/falcon-pl-mm/MM_CANCEL_ALL
